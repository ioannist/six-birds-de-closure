      (GroundNativeTransportGeometry.around Step000.u Step000.v 0 Step000.s))).I i).bound ≤ centerGap := by decide +kernel

theorem center_gap : dist (centers 4) (centers 0) ≤ (centerGap : ℝ) := by
  exact GroundCertifiedNativeEntry.coordinate_distance Step000.certificate center_gap_rows.1
    (GroundNativeTransportGeometry.point_enclosed Step007.next_u Step007.next_v
      (by norm_num : (0 : ℚ) ≤ 0) Step007.basis_nonneg)
    (GroundNativeTransportGeometry.point_enclosed Step000.u Step000.v
      (by norm_num : (0 : ℚ) ≤ 0) Step000.basis_nonneg) center_gap_rows.2

theorem second_center_gap_rows : 0 ≤ secondCenterGap ∧ ∀ i : Fin 8,
    ((Step000.certificate.coordinateBox (GroundCertifiedNativeEntry.differenceBox
      (GroundNativeTransportGeometry.around Step001.next_u Step001.next_v 0 Step001.s)
      (GroundNativeTransportGeometry.around Step000.u Step000.v 0 Step000.s))).R i).bound ≤ secondCenterGap ∧
    ((Step000.certificate.coordinateBox (GroundCertifiedNativeEntry.differenceBox
      (GroundNativeTransportGeometry.around Step001.next_u Step001.next_v 0 Step001.s)
      (GroundNativeTransportGeometry.around Step000.u Step000.v 0 Step000.s))).I i).bound ≤ secondCenterGap := by decide +kernel

theorem second_center_gap : dist (centers 1) (centers 0) ≤ (secondCenterGap : ℝ) := by
  exact GroundCertifiedNativeEntry.coordinate_distance Step000.certificate second_center_gap_rows.1
    (GroundNativeTransportGeometry.point_enclosed Step001.next_u Step001.next_v
      (by norm_num : (0 : ℚ) ≤ 0) Step001.basis_nonneg)
    (GroundNativeTransportGeometry.point_enclosed Step000.u Step000.v
      (by norm_num : (0 : ℚ) ≤ 0) Step000.basis_nonneg) second_center_gap_rows.2


theorem second_self_defect : dist ((f^[2]) (centers 0)) (centers 0) ≤ (secondSelfDefect : ℝ) := by
  calc
    _ ≤ dist ((f^[2]) (centers 0)) (centers 1)+dist (centers 1) (centers 0) := dist_triangle _ _ _
    _ ≤ (Pair000.pairDefect : ℝ)+(secondCenterGap : ℝ) :=
      add_le_add (Pair000.pair.center_defect NativeCycleFrame20.background_sound) second_center_gap
    _ = (secondSelfDefect : ℝ) := by norm_num [Pair000.pairDefect,secondCenterGap,secondSelfDefect]

end
