theorem upper_cells : ∀ i : Fin 1024,
    0 < grid i ∧ grid i ≤ grid (i + 1) ∧ 0 ≤ upper i ∧
      ((2 * (17/5) * (grid (i+1))^3 ≤ 1 ∧
        (grid (i+1))^3 ≤ (upper i)^2 * (1 + (17/5) * (grid (i+1))^3)^3) ∨
      (1 ≤ 2 * (17/5) * (grid i)^3 ∧
        (grid i)^3 ≤ (upper i)^2 * (1 + (17/5) * (grid i)^3)^3) ∨
      4 ≤ 27 * (17/5) * (upper i)^2) := by
  decide +kernel

theorem upper_sum : (∑ i ∈ Finset.range 1024, (grid (i+1) - grid i) * upper i) ≤ (4159 : ℚ) / 20000 := by
  decide +kernel

