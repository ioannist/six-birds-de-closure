def g : ComplexField → ComplexField := nativeUpdate (GroundNativePrefixInitial.τ : ℝ)
  (GroundKernelTube.background GroundOriginalFirstTube.originalBackground) (NativeStableFrame004.κ : ℝ) (1/2)

theorem initial : NativeStableFrame004.T.symm (unpack GroundOriginalSeed.initial) ∈
    closedBall (tube.centers 0) (tube.radii 0 : ℝ) := Geometry.original_seed_enclosed

theorem source_enclosed_even (j : Fin (N+1)) :
    NativeStableFrame004.T.symm (unpack ((g^[2*j.val]) GroundOriginalSeed.initial)) ∈
      closedBall (tube.centers j) (tube.radii j : ℝ) := by
  rw [g,NativePairOrbit.coordinate_from_source]
  exact tube.enclosed NativeStableFrame004.background_sound initial j

theorem guards_before (n : ℕ) (hn : n < 2*N) :
    ActivePhase (GroundNativePrefixInitial.τ : ℝ)
      (GroundKernelTube.background GroundOriginalFirstTube.originalBackground) (NativeStableFrame004.κ : ℝ)
      ((g^[n]) GroundOriginalSeed.initial) ∧
    NativeLegal (GroundNativePrefixInitial.τ : ℝ)
      (GroundKernelTube.background GroundOriginalFirstTube.originalBackground) (NativeStableFrame004.κ : ℝ) (1/2)
      ((g^[n]) GroundOriginalSeed.initial) :=
  NativeOriginalSeedCycleReturn.finite_source_guards tube NativeStableFrame004.background_sound initial n hn

theorem unit_before (j : Fin (2*N+1)) : complexNormSq ((g^[j.val]) GroundOriginalSeed.initial) = 1 := by
  refine Fin.induction ?_ (fun i _ => ?_) j
  · exact GroundOriginalSeed.initial_unit
  · change complexNormSq ((g^[i.val+1]) GroundOriginalSeed.initial) = 1
    rw [Function.iterate_succ_apply']
    exact GroundNativeEscape.nativeUpdate_unit
      (by exact_mod_cast Step000.threshold_nonneg) (guards_before i.val i.isLt).2

def target : State := Geometry.actualTarget

/-- Earned entry into the actual negative root's populated native basin. -/
theorem original_seed_entry : NativeStableFrame004.T.symm (unpack ((g^[2*N]) GroundOriginalSeed.initial)) ∈
    closedBall (NativeStableFrame004.T.symm (-NativeStableFrame004.u,0)) (NativeStable004Arithmetic.ρ : ℝ) := by
  exact Geometry.actual_root_entry_of_enclosure (source_enclosed_even (Fin.last N))

/-- Actual original-seed convergence, with every finite and infinite guard and unit norm. -/
theorem original_seed_return : Tendsto (fun n : ℕ => (g^[n]) GroundOriginalSeed.initial) atTop
      (nhds (realEmbed (-NativeStableFrame004.u))) ∧
    ∀ n : ℕ, ActivePhase GroundNativeControls.originalTolerance
      (GroundKernelTube.background GroundOriginalFirstTube.originalBackground) (NativeStableFrame004.κ : ℝ)
      ((g^[n]) GroundOriginalSeed.initial) ∧
      NativeLegal GroundNativeControls.originalTolerance
        (GroundKernelTube.background GroundOriginalFirstTube.originalBackground) (NativeStableFrame004.κ : ℝ) (1/2)
        ((g^[n]) GroundOriginalSeed.initial) ∧ complexNormSq ((g^[n]) GroundOriginalSeed.initial) = 1 := by
  have he : NativeStableFrame004.T.symm (unpack (ReturnBridge.orbit (2*N))) ∈
      closedBall (NativeStableFrame004.T.symm (-NativeStableFrame004.u,0)) (NativeStable004Arithmetic.ρ : ℝ) := by
    simpa only [ReturnBridge.orbit,ReturnBridge.g,NativeStable004.g,g,GroundNativePrefixInitial.tolerance_return] using original_seed_entry
  have hp (j : Fin (2*N)) : ActivePhase GroundNativeControls.originalTolerance
      (GroundKernelTube.background GroundOriginalFirstTube.originalBackground) (NativeStableFrame004.κ : ℝ)
      (ReturnBridge.orbit j.val) ∧ NativeLegal GroundNativeControls.originalTolerance
      (GroundKernelTube.background GroundOriginalFirstTube.originalBackground) (NativeStableFrame004.κ : ℝ) (1/2)
      (ReturnBridge.orbit j.val) := by
    simpa only [ReturnBridge.orbit,ReturnBridge.g,NativeStable004.g,g,GroundNativePrefixInitial.tolerance_return]
      using guards_before j.val j.isLt
  simpa only [ReturnBridge.orbit,ReturnBridge.g,NativeStable004.g,g,GroundNativePrefixInitial.tolerance_return]
    using ReturnBridge.original_seed_return_of_entry (2*N) he hp

theorem original_seed_density_limit (j : Fin 8) :
    Tendsto (fun n : ℕ => Complex.normSq (((g^[n]) GroundOriginalSeed.initial) j)) atTop
      (nhds (Complex.normSq (realEmbed NativeStableFrame004.u j))) := by
  have hc : Continuous (fun x : ComplexField => Complex.normSq (x j)) := by fun_prop
  have ht := (hc.tendsto (realEmbed (-NativeStableFrame004.u))).comp original_seed_return.1
  simpa only [realEmbed,Pi.neg_apply,Complex.normSq_ofReal,mul_neg,neg_mul,neg_neg] using ht

def previousBox : StateBox := Step059.certificate.input
def currentBox : StateBox := around (u (Fin.last N)) (v (Fin.last N)) (radii (Fin.last N)) Step000.s

theorem previous_enclosed : previousBox.Contains (unpack ((g^[59]) GroundOriginalSeed.initial)) := by
  exact NativeFiniteSourceBoxes.before_endpoint tube NativeStableFrame004.background_sound initial ⟨59,by decide⟩

theorem current_enclosed : currentBox.Contains (unpack ((g^[60]) GroundOriginalSeed.initial)) := by
  exact NativeFiniteSourceBoxes.at_endpoint tube NativeStableFrame004.background_sound initial
    (u (Fin.last N)) (v (Fin.last N)) rfl rfl Step000.basis_nonneg
    (Step000.certificate.basis_norm Step000.basis_nonneg Step000.basis_rows)
