theorem responses : certificate.ResponseArithmetic := by
  intro j
  fin_cases j <;> constructor <;> decide +kernel

theorem response_included : certificate.ResponseIncluded := by
  intro j
  fin_cases j <;> unfold included <;> decide +kernel

