theorem ground_arithmetic : GroundBackgroundKernel.Arithmetic
    (GroundUncertainNativeBox.sourceBox GroundOffsets.Point001.B GroundOffsets.Point001.κ input) z r q a C := by
  constructor <;> decide +kernel

theorem phase_arithmetic : GroundIntervalReciprocal.Arithmetic (overlapBox input (GroundBackgroundKernel.fieldBox z r)) K := by
  constructor <;> decide +kernel

theorem mixed_arithmetic : GroundIntervalReciprocal.Arithmetic (normBox (mixedBox input (GroundBackgroundKernel.fieldBox z r) K)) L := by
  constructor <;> decide +kernel

theorem threshold_nonneg : 0 ≤ GroundNativePrefixInitial.τ := by decide +kernel
