def δ : ℚ := (29009979343780622151300841/1267650600228229401496703205376)

theorem center_arithmetic : 0 ≤ γ ∧ ∀ j : Fin 8,
    (((GroundOriginalOffsetBasins.data 16).c.coordinateBox (differenceBox
      (around (certificate.u (Fin.last N)) (certificate.v (Fin.last N)) 0 0)
      (negativeTargetBox (GroundOriginalOffsets.certificates 16).z
        (GroundOriginalOffsets.certificates 16).r))).R j).bound ≤ γ ∧
    (((GroundOriginalOffsetBasins.data 16).c.coordinateBox (differenceBox
      (around (certificate.u (Fin.last N)) (certificate.v (Fin.last N)) 0 0)
      (negativeTargetBox (GroundOriginalOffsets.certificates 16).z
        (GroundOriginalOffsets.certificates 16).r))).I j).bound ≤ γ := by
  decide +kernel

theorem entry_arithmetic : 0 ≤ δ ∧ certificate.radius (Fin.last N)+γ ≤ δ ∧
    δ < (GroundOriginalOffsetBasins.data 16).ρ := by decide +kernel

theorem distance {b : Field} (hb : ∀ j, (β 16 j).Contains (b j)) :
    dist ((GroundOriginalOffsetBasins.T 16).symm (unpack (orbit 16 b N)))
      ((GroundOriginalOffsetBasins.T 16).symm (-(GroundOriginalOffsetStability.wholeRoot 16 hb).1,0)) ≤ (δ : ℝ) := by
  have hc := center_distance 16 certificate hb center_arithmetic.1 center_arithmetic.2
  have hd := endpoint_distance 16 certificate hb hc
  have hbudget : (certificate.radius (Fin.last N) : ℝ)+(γ : ℝ) ≤ (δ : ℝ) := by
    exact_mod_cast entry_arithmetic.2.1
  exact hd.trans hbudget

theorem entry {b : Field} (hb : ∀ j, (β 16 j).Contains (b j)) :
    (GroundOriginalOffsetBasins.T 16).symm (unpack (orbit 16 b N)) ∈ closedBall
      ((GroundOriginalOffsetBasins.T 16).symm (-(GroundOriginalOffsetStability.wholeRoot 16 hb).1,0))
      ((GroundOriginalOffsetBasins.data 16).ρ : ℝ) := by
  rw [mem_closedBall]
  exact (distance hb).trans (Rat.cast_le.mpr entry_arithmetic.2.2.le)

theorem seed_return {b : Field} (hb : ∀ j, (β 16 j).Contains (b j)) :
    Tendsto (orbit 16 b) atTop (nhds (realEmbed (-(GroundOriginalOffsetStability.wholeRoot 16 hb).1))) ∧
    ∀ n : ℕ, ActivePhase GroundNativeControls.originalTolerance b (κ 16 : ℝ) (orbit 16 b n) ∧
      NativeLegal GroundNativeControls.originalTolerance b (κ 16 : ℝ) (1/2) (orbit 16 b n) ∧
      complexNormSq (orbit 16 b n) = 1 :=
  whole_seed_return 16 certificate hb (entry hb)
