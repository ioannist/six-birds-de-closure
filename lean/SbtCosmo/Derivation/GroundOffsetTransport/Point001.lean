    exact coordinate_distance (GroundOriginalOffsetBasins.data 1).c initial_arithmetic.1
      GroundOffsetPrefixInitial.original_seed_enclosed
      (point_enclosed (u 0) (v 0) (by norm_num : (0 : ℚ) ≤ 0) (by norm_num : (0 : ℚ) ≤ 0))
      initial_arithmetic.2

def γ : ℚ := (6857661336553070551585599/316912650057057350374175801344)
def δ : ℚ := (13715322685052604095158763/633825300114114700748351602688)

theorem center_arithmetic : 0 ≤ γ ∧ ∀ j : Fin 8,
    (((GroundOriginalOffsetBasins.data 1).c.coordinateBox (differenceBox
      (around (certificate.u (Fin.last N)) (certificate.v (Fin.last N)) 0 0)
      (negativeTargetBox (GroundOriginalOffsets.certificates 1).z
        (GroundOriginalOffsets.certificates 1).r))).R j).bound ≤ γ ∧
    (((GroundOriginalOffsetBasins.data 1).c.coordinateBox (differenceBox
      (around (certificate.u (Fin.last N)) (certificate.v (Fin.last N)) 0 0)
      (negativeTargetBox (GroundOriginalOffsets.certificates 1).z
        (GroundOriginalOffsets.certificates 1).r))).I j).bound ≤ γ := by
  decide +kernel

theorem entry_arithmetic : 0 ≤ δ ∧ certificate.radius (Fin.last N)+γ ≤ δ ∧
    δ < (GroundOriginalOffsetBasins.data 1).ρ := by decide +kernel

theorem distance {b : Field} (hb : ∀ j, (β 1 j).Contains (b j)) :
    dist ((GroundOriginalOffsetBasins.T 1).symm (unpack (orbit 1 b N)))
      ((GroundOriginalOffsetBasins.T 1).symm (-(GroundOriginalOffsetStability.wholeRoot 1 hb).1,0)) ≤ (δ : ℝ) := by
  have hc := center_distance 1 certificate hb center_arithmetic.1 center_arithmetic.2
  have hd := endpoint_distance 1 certificate hb hc
  have hbudget : (certificate.radius (Fin.last N) : ℝ)+(γ : ℝ) ≤ (δ : ℝ) := by
    exact_mod_cast entry_arithmetic.2.1
  exact hd.trans hbudget

theorem entry {b : Field} (hb : ∀ j, (β 1 j).Contains (b j)) :
    (GroundOriginalOffsetBasins.T 1).symm (unpack (orbit 1 b N)) ∈ closedBall
      ((GroundOriginalOffsetBasins.T 1).symm (-(GroundOriginalOffsetStability.wholeRoot 1 hb).1,0))
      ((GroundOriginalOffsetBasins.data 1).ρ : ℝ) := by
  rw [mem_closedBall]
  exact (distance hb).trans (Rat.cast_le.mpr entry_arithmetic.2.2.le)

theorem seed_return {b : Field} (hb : ∀ j, (β 1 j).Contains (b j)) :
    Tendsto (orbit 1 b) atTop (nhds (realEmbed (-(GroundOriginalOffsetStability.wholeRoot 1 hb).1))) ∧
    ∀ n : ℕ, ActivePhase GroundNativeControls.originalTolerance b (κ 1 : ℝ) (orbit 1 b n) ∧
      NativeLegal GroundNativeControls.originalTolerance b (κ 1 : ℝ) (1/2) (orbit 1 b n) ∧
      complexNormSq (orbit 1 b n) = 1 :=
  whole_seed_return 1 certificate hb (entry hb)
end
