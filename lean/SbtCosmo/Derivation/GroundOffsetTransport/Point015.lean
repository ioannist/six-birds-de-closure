theorem source_seams : ∀ j : Fin N,
    (steps j).u = u j.castSucc ∧ (steps j).v = v j.castSucc ∧ (steps j).radius = radius j.castSucc := by
  intro j
  fin_cases j <;> exact ⟨rfl,rfl,rfl⟩

theorem target_seams : ∀ j : Fin N,
    (steps j).next_u = u j.succ ∧ (steps j).next_v = v j.succ ∧ (steps j).next_radius = radius j.succ := by
  intro j
  fin_cases j <;> exact ⟨rfl,rfl,rfl⟩

theorem initial_arithmetic : 0 ≤ radius 0 ∧ ∀ j : Fin 8,
    (((GroundOriginalOffsetBasins.data 15).c.coordinateBox
      (differenceBox GroundOffsetPrefixInitial.initialBox (around (u 0) (v 0) 0 0))).R j).bound ≤ radius 0 ∧
    (((GroundOriginalOffsetBasins.data 15).c.coordinateBox
      (differenceBox GroundOffsetPrefixInitial.initialBox (around (u 0) (v 0) 0 0))).I j).bound ≤ radius 0 := by
  decide +kernel

def certificate : Prefix 15 N where
  u := u
  v := v
  radius := radius
  steps := steps
  source_seams := source_seams
  target_seams := target_seams
  threshold_nonneg := GroundOffsetTransport.Point015.Step000.threshold_nonneg
  initial := by
    rw [mem_closedBall]
    exact coordinate_distance (GroundOriginalOffsetBasins.data 15).c initial_arithmetic.1
      GroundOffsetPrefixInitial.original_seed_enclosed
      (point_enclosed (u 0) (v 0) (by norm_num : (0 : ℚ) ≤ 0) (by norm_num : (0 : ℚ) ≤ 0))
      initial_arithmetic.2

def γ : ℚ := (24971296953409034371576551/1267650600228229401496703205376)
def δ : ℚ := (24971296966151295614407225/1267650600228229401496703205376)

theorem center_arithmetic : 0 ≤ γ ∧ ∀ j : Fin 8,
    (((GroundOriginalOffsetBasins.data 15).c.coordinateBox (differenceBox
      (around (certificate.u (Fin.last N)) (certificate.v (Fin.last N)) 0 0)
      (negativeTargetBox (GroundOriginalOffsets.certificates 15).z
        (GroundOriginalOffsets.certificates 15).r))).R j).bound ≤ γ ∧
    (((GroundOriginalOffsetBasins.data 15).c.coordinateBox (differenceBox
      (around (certificate.u (Fin.last N)) (certificate.v (Fin.last N)) 0 0)
      (negativeTargetBox (GroundOriginalOffsets.certificates 15).z
        (GroundOriginalOffsets.certificates 15).r))).I j).bound ≤ γ := by
  decide +kernel

theorem entry_arithmetic : 0 ≤ δ ∧ certificate.radius (Fin.last N)+γ ≤ δ ∧
    δ < (GroundOriginalOffsetBasins.data 15).ρ := by decide +kernel

theorem distance {b : Field} (hb : ∀ j, (β 15 j).Contains (b j)) :
    dist ((GroundOriginalOffsetBasins.T 15).symm (unpack (orbit 15 b N)))
      ((GroundOriginalOffsetBasins.T 15).symm (-(GroundOriginalOffsetStability.wholeRoot 15 hb).1,0)) ≤ (δ : ℝ) := by
  have hc := center_distance 15 certificate hb center_arithmetic.1 center_arithmetic.2
  have hd := endpoint_distance 15 certificate hb hc
  have hbudget : (certificate.radius (Fin.last N) : ℝ)+(γ : ℝ) ≤ (δ : ℝ) := by
    exact_mod_cast entry_arithmetic.2.1
  exact hd.trans hbudget

theorem entry {b : Field} (hb : ∀ j, (β 15 j).Contains (b j)) :
    (GroundOriginalOffsetBasins.T 15).symm (unpack (orbit 15 b N)) ∈ closedBall
      ((GroundOriginalOffsetBasins.T 15).symm (-(GroundOriginalOffsetStability.wholeRoot 15 hb).1,0))
      ((GroundOriginalOffsetBasins.data 15).ρ : ℝ) := by
  rw [mem_closedBall]
  exact (distance hb).trans (Rat.cast_le.mpr entry_arithmetic.2.2.le)

theorem seed_return {b : Field} (hb : ∀ j, (β 15 j).Contains (b j)) :
    Tendsto (orbit 15 b) atTop (nhds (realEmbed (-(GroundOriginalOffsetStability.wholeRoot 15 hb).1))) ∧
    ∀ n : ℕ, ActivePhase GroundNativeControls.originalTolerance b (κ 15 : ℝ) (orbit 15 b n) ∧
      NativeLegal GroundNativeControls.originalTolerance b (κ 15 : ℝ) (1/2) (orbit 15 b n) ∧
      complexNormSq (orbit 15 b n) = 1 :=
  whole_seed_return 15 certificate hb (entry hb)
