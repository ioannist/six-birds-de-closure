theorem ground_arithmetic : GroundBackgroundKernel.Arithmetic
    (GroundUncertainNativeBox.sourceBox NativeCycleFrame20.B NativeCycleFrame20.κ input) z r q a C := by
  constructor <;> decide +kernel

theorem phase_arithmetic : GroundIntervalReciprocal.Arithmetic (overlapBox input (GroundBackgroundKernel.fieldBox z r)) K := by
  constructor <;> decide +kernel

theorem mixed_arithmetic : GroundIntervalReciprocal.Arithmetic (normBox (mixedBox input (GroundBackgroundKernel.fieldBox z r) K)) L := by
  constructor <;> decide +kernel

theorem threshold_nonneg : 0 ≤ GroundNativePrefixInitial.τ := by decide +kernel
theorem phase_margin : GroundNativePrefixInitial.τ^2 < (overlapBox input (GroundBackgroundKernel.fieldBox z r)).lo := by decide +kernel
theorem mixed_margin : GroundNativePrefixInitial.τ^2 < (normBox (mixedBox input (GroundBackgroundKernel.fieldBox z r) K)).lo := by decide +kernel

def certificate : Certificate where
  β := NativeCycleFrame20.B
  κ := NativeCycleFrame20.κ
  τ := GroundNativePrefixInitial.τ
  input := input
  z := z
  r := r
  q := q
  a := a
  C := C
  K := K
  L := L
  S := NativeCycleFrame20.S
  P := NativeCycleFrame20.P
  R := NativeCycleFrame20.R
  Q := NativeCycleFrame20.Q
  real_inverse := NativeCycleFrame20.real_inverse
  imag_inverse := NativeCycleFrame20.imag_inverse
  DG := DG
  DF := DF
  y := y
  e := e
  rate := rate
  ground := ground_arithmetic
  phase_inverse := phase_arithmetic
  mixed_inverse := mixed_arithmetic
  threshold_nonneg := threshold_nonneg
  phase_margin := phase_margin
  normalization_margin := mixed_margin

theorem responses : certificate.ResponseArithmetic := by
  intro j
  fin_cases j <;> constructor <;> decide +kernel

theorem response_included : certificate.ResponseIncluded := by
  intro j
  fin_cases j <;> unfold included <;> decide +kernel

theorem derivative_included : certificate.DerivativeIncluded := by
  intro j
  fin_cases j <;> unfold StateBox.Included included <;> decide +kernel

theorem rows : GroundNativeTransportJets.RowBounds certificate := by
  constructor
  · decide +kernel
  · intro i; fin_cases i <;> decide +kernel
  · intro i; fin_cases i <;> decide +kernel

theorem basis_rows : ∀ i : Fin 8, (∑ j, |certificate.S i j|) ≤ s ∧ (∑ j, |certificate.R i j|) ≤ s := by decide +kernel
theorem radius_nonneg : 0 ≤ ρ := by decide +kernel
theorem basis_nonneg : 0 ≤ s := by decide +kernel

