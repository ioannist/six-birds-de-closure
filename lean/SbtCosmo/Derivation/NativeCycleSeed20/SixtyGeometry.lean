theorem gap_arithmetic : (1/4 : ℚ) < (difference.R 4).lo := by decide +kernel

theorem difference_enclosed {previous current : ComplexField}
    (hp : previousBox.Contains (unpack previous)) (hc : currentBox.Contains (unpack current)) :
    difference.Contains (unpack (current-previous)) := by
  simpa only [← packCLE_symm_apply,map_sub] using differenceBox_sound hc hp

/-- Closed scalar endpoint budget only. The actual orbit must still be bound
to the two certified boxes by the populated finite source transport. -/
theorem update_gap_of_enclosures {previous current : ComplexField}
    (hp : previousBox.Contains (unpack previous)) (hc : currentBox.Contains (unpack current)) :
    (1/4 : ℝ) < l2 (current-previous) := by
  have ha : ((1/4 : ℚ) : ℝ) < ((difference.R 4).lo : ℝ) := Rat.cast_lt.mpr gap_arithmetic
  norm_num only [Rat.cast_div,Rat.cast_ofNat] at ha
  have hb := (difference_enclosed hp hc 4).1.1
  exact ha.trans_le (hb.trans ((le_abs_self _).trans (real_component_le_l2 (current-previous) 4)))

