      (GroundKernelTube.background GroundOriginalFirstTube.originalBackground) (NativeCycleFrame20.κ : ℝ) (1/2)
      ((g^[59]) GroundOriginalSeed.initial) ((g^[60]) GroundOriginalSeed.initial) := by
  intro h
  have ht : GroundOriginalResiduals.ε < (1/4 : ℝ) := by norm_num [GroundOriginalResiduals.ε]
  exact (not_lt_of_ge h.1) (ht.trans (last_update_gap_of_enclosures hp hc))
