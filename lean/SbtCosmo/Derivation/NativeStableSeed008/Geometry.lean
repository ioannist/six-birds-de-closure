def initialCenter : State := NativeStableFrame008.T.symm (point initial_u initial_v)
def endpointCenter : State := NativeStableFrame008.T.symm (point endpoint_u endpoint_v)
def actualTarget : State := NativeStableFrame008.T.symm (-NativeStableFrame008.u,0)

theorem initial_arithmetic : 0 ≤ initialRadius ∧ ∀ j : Fin 8,
    ((NativeStable008Arithmetic.certificate.coordinateBox (differenceBox GroundOffsetPrefixInitial.initialBox
      (around initial_u initial_v 0 0))).R j).bound ≤ initialRadius ∧
    ((NativeStable008Arithmetic.certificate.coordinateBox (differenceBox GroundOffsetPrefixInitial.initialBox
      (around initial_u initial_v 0 0))).I j).bound ≤ initialRadius := by decide +kernel

/-- Earned enclosure of the actual source seed, including both initial normalizations. -/
theorem original_seed_enclosed : NativeStableFrame008.T.symm (unpack GroundOriginalSeed.initial) ∈
    closedBall initialCenter (initialRadius : ℝ) := by
  rw [mem_closedBall]
  exact coordinate_distance NativeStable008Arithmetic.certificate initial_arithmetic.1
    GroundOffsetPrefixInitial.original_seed_enclosed
    (point_enclosed initial_u initial_v (by norm_num : (0 : ℚ) ≤ 0) (by norm_num : (0 : ℚ) ≤ 0))
    initial_arithmetic.2

theorem center_arithmetic : 0 ≤ centerDistance ∧ ∀ j : Fin 8,
    ((NativeStable008Arithmetic.certificate.coordinateBox (differenceBox (around endpoint_u endpoint_v 0 0)
      (negativeTargetBox NativeStableFrame008.z NativeStableFrame008.r))).R j).bound ≤ centerDistance ∧
    ((NativeStable008Arithmetic.certificate.coordinateBox (differenceBox (around endpoint_u endpoint_v 0 0)
      (negativeTargetBox NativeStableFrame008.z NativeStableFrame008.r))).I j).bound ≤ centerDistance := by decide +kernel

theorem center_distance : dist endpointCenter actualTarget ≤ (centerDistance : ℝ) := by
  exact coordinate_distance NativeStable008Arithmetic.certificate center_arithmetic.1
    (point_enclosed endpoint_u endpoint_v (by norm_num : (0 : ℚ) ≤ 0) (by norm_num : (0 : ℚ) ≤ 0))
    (negativeTargetBox_sound NativeStableFrame008.root_enclosed) center_arithmetic.2

theorem entry_arithmetic : 0 ≤ endpointRadius ∧ endpointRadius+centerDistance ≤ entryBound ∧
    entryBound < NativeStable008Arithmetic.ρ := by decide +kernel

/-- Only the endpoint geometry. The actual finite orbit enclosure is a separate obligation. -/
theorem actual_root_entry_of_enclosure {z : ComplexField}
    (hz : NativeStableFrame008.T.symm (unpack z) ∈ closedBall endpointCenter (endpointRadius : ℝ)) :
    NativeStableFrame008.T.symm (unpack z) ∈ closedBall actualTarget (NativeStable008Arithmetic.ρ : ℝ) := by
  rw [mem_closedBall]
  have h := GroundFiniteNativeTransport.endpoint_distance hz center_distance
  apply h.trans
  exact_mod_cast entry_arithmetic.2.1.trans entry_arithmetic.2.2.le
end
