  have hx : (differenceBox currentBox candidateBox).Contains
      (unpack (orbit 60-(-nativeCandidate (b) (NativeStableFrame005.κ : ℝ) (orbit 60)))) := by
    simpa only [← packCLE_symm_apply,map_sub] using
      differenceBox_sound hc (actual_candidate_enclosed hc)
  exact box_l2_bound hx (by decide +kernel) distance_arithmetic.1

theorem actual_update_distance (hp : previousBox.Contains (unpack (orbit 59))) (hc : currentBox.Contains (unpack (orbit 60))) : l2 (orbit 60-orbit 59) ≤ (update : ℝ) := by
  have hx : (differenceBox currentBox previousBox).Contains (unpack (orbit 60-orbit 59)) := by
    simpa only [← packCLE_symm_apply,map_sub] using
      differenceBox_sound hc hp
  exact box_l2_bound hx (by decide +kernel) distance_arithmetic.2

theorem actual_potential_bounds (hc : currentBox.Contains (unpack (orbit 60))) : ∀ j,
    (A : ℝ) ≤ complexSourcePotential (b) (NativeStableFrame005.κ : ℝ) (orbit 60) j ∧
      complexSourcePotential (b) (NativeStableFrame005.κ : ℝ) (orbit 60) j ≤ (B : ℝ) := by
  have hp := source_pack (b) (NativeStableFrame005.κ : ℝ) (unpack (orbit 60))
  rw [show pack (unpack (orbit 60)) = orbit 60 from packCLE.apply_symm_apply _] at hp
  intro j
  have hs := GroundUncertainNativeBox.sourceBox_sound (NativeStableFrame005.B) (NativeStableFrame005.κ) (NativeStableFrame005.background_sound) hc j
  change (GroundUncertainNativeBox.sourceBox NativeStableFrame005.B NativeStableFrame005.κ currentBox j).Contains
    (pairSource b (NativeStableFrame005.κ : ℝ) (unpack (orbit 60)) j) at hs
  rw [← hp] at hs
  exact ⟨(Rat.cast_le.mpr (source_bounds_arithmetic j).1).trans hs.1,
    hs.2.trans (Rat.cast_le.mpr (source_bounds_arithmetic j).2)⟩

theorem actual_four_source_tests (hp : previousBox.Contains (unpack (orbit 59))) (hc : currentBox.Contains (unpack (orbit 60))) (hu : complexNormSq (orbit 60) = 1) : MeetsConvergence GroundNativeControls.originalTolerance
    GroundOriginalResiduals.ε (b) (NativeStableFrame005.κ : ℝ) (1/2)
      (orbit 59) (orbit 60) := by
  have hstep : nativeUpdate GroundNativeControls.originalTolerance
      (b) (NativeStableFrame005.κ : ℝ) (1/2) (orbit 59) = orbit 60 :=
    (Function.iterate_succ_apply' (g) 59 GroundOriginalSeed.initial).symm
  apply tests_of_budgets GroundNativeControls.originalTolerance_guard.1
    (by norm_num [GroundOriginalResiduals.ε]) (by norm_num [d])
    hu
    (actual_candidate_distance hc) (actual_update_distance hp hc) hstep (actual_potential_bounds hc)
  · norm_num [d]
  · norm_num [d,GroundNativeControls.originalTolerance]
  · norm_num [d,update,A,B,GroundOriginalResiduals.ε]

end
