import SbtCosmo.Derivation.GroundNativePrefixInitial

/-! Refined600-bit initial enclosure, preserving both original normalizations. -/
namespace SbtCosmo.Derivation.GroundOffsetPrefixInitial
noncomputable section
set_option maxHeartbeats 100000000
set_option maxRecDepth 100000
open GroundState GroundNativePhase GroundRationalInterval GroundNativeBox GroundOriginalSeed

def K : Interval := ⟨(), ()⟩
def initialBox : StateBox := ⟨![⟨(), ()⟩, ⟨(), ()⟩, ⟨(-), (-)⟩, ⟨(-), (-)⟩, ⟨(-), (-)⟩, ⟨(-), (-)⟩, ⟨(), ()⟩, ⟨(), ()⟩], ![⟨(), ()⟩, ⟨(), ()⟩, ⟨(), ()⟩, ⟨(), ()⟩, ⟨(), ()⟩, ⟨(-), (-)⟩, ⟨(-), (-)⟩, ⟨(-), (-)⟩]⟩

theorem inverse_arithmetic : GroundIntervalReciprocal.Arithmetic (Interval.point rawNorm) K := by
  constructor <;> decide +kernel

theorem initial_inclusion : (normalizedBox GroundNativePrefixInitial.rawBox K).Included initialBox := by
  unfold StateBox.Included included
  decide +kernel

theorem original_seed_enclosed : initialBox.Contains (unpack initial) := by
  have hn : (Interval.point rawNorm).Contains (stateNormSq rawState) := by
    rw [raw_norm_return]; exact Interval.point_sound rawNorm
  have hk := (GroundIntervalReciprocal.inverse_sqrt_sound inverse_arithmetic hn).2
  have hx := StateBox.included_sound initial_inclusion
    (normalizedBox_sound GroundNativePrefixInitial.raw_box_sound hk)
  rw [double_normalization]
  exact hx

end
end SbtCosmo.Derivation.GroundOffsetPrefixInitial
