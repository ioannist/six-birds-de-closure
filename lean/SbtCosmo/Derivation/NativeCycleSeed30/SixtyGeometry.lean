theorem gap_arithmetic : (1/4 : ℚ) < (difference.R 4).lo := by decide +kernel

theorem difference_enclosed {previous current : ComplexField}
    (hp : previousBox.Contains (unpack previous)) (hc : currentBox.Contains (unpack current)) :
    difference.Contains (unpack (current-previous)) := by
  simpa only [← packCLE_symm_apply,map_sub] using differenceBox_sound hc hp

/-- Closed scalar endpoint budget only. The actual orbit must still be bound
to the two certified boxes by the populated finite source transport. -/
theorem update_gap_of_enclosures {previous current : ComplexField}
    (hp : previousBox.Contains (unpack previous)) (hc : currentBox.Contains (unpack current)) :
    (1/4 : ℝ) < l2 (current-previous) := by
  have ha : ((1/4 : ℚ) : ℝ) < ((difference.R 4).lo : ℝ) := Rat.cast_lt.mpr gap_arithmetic
  norm_num only [Rat.cast_div,Rat.cast_ofNat] at ha
  have hb := (difference_enclosed hp hc 4).1.1
  exact ha.trans_le (hb.trans ((le_abs_self _).trans (real_component_le_l2 (current-previous) 4)))

def g : ComplexField → ComplexField := nativeUpdate GroundNativeControls.originalTolerance
  (GroundKernelTube.background GroundOriginalFirstTube.originalBackground) (NativeCycleFrame30.κ : ℝ) (1/2)

theorem last_update_gap_of_enclosures
    (hp : previousBox.Contains (unpack ((g^[59]) GroundOriginalSeed.initial)))
    (hc : currentBox.Contains (unpack ((g^[60]) GroundOriginalSeed.initial))) :
    (1/4 : ℝ) < lastUpdateResidual GroundNativeControls.originalTolerance
      (GroundKernelTube.background GroundOriginalFirstTube.originalBackground) (NativeCycleFrame30.κ : ℝ) (1/2)
      ((g^[59]) GroundOriginalSeed.initial) := by
  have h := update_gap_of_enclosures hp hc
  have he : nativeUpdate GroundNativeControls.originalTolerance
      (GroundKernelTube.background GroundOriginalFirstTube.originalBackground) (NativeCycleFrame30.κ : ℝ) (1/2)
      ((g^[59]) GroundOriginalSeed.initial) = (g^[60]) GroundOriginalSeed.initial :=
    (Function.iterate_succ_apply' g 59 GroundOriginalSeed.initial).symm
  rw [lastUpdateResidual,he]
  exact h

theorem four_source_tests_fail_of_enclosures
    (hp : previousBox.Contains (unpack ((g^[59]) GroundOriginalSeed.initial)))
    (hc : currentBox.Contains (unpack ((g^[60]) GroundOriginalSeed.initial))) :
    ¬ MeetsConvergence GroundNativeControls.originalTolerance GroundOriginalResiduals.ε
      (GroundKernelTube.background GroundOriginalFirstTube.originalBackground) (NativeCycleFrame30.κ : ℝ) (1/2)
      ((g^[59]) GroundOriginalSeed.initial) ((g^[60]) GroundOriginalSeed.initial) := by
  intro h
  have ht : GroundOriginalResiduals.ε < (1/4 : ℝ) := by norm_num [GroundOriginalResiduals.ε]
  exact (not_lt_of_ge h.1) (ht.trans (last_update_gap_of_enclosures hp hc))
