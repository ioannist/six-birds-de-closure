def g : ComplexField → ComplexField := nativeUpdate (GroundNativePrefixInitial.τ : ℝ)
  (GroundKernelTube.background GroundOriginalFirstTube.originalBackground) (NativeCycleFrame30.κ : ℝ) (1/2)

theorem initial : NativeCycleFrame30.T.symm (unpack GroundOriginalSeed.initial) ∈
    closedBall (tube.centers 0) (tube.radii 0 : ℝ) := Initial.original_seed_enclosed

theorem source_enclosed_even (j : Fin (N+1)) :
    NativeCycleFrame30.T.symm (unpack ((g^[2*j.val]) GroundOriginalSeed.initial)) ∈
      closedBall (tube.centers j) (tube.radii j : ℝ) := by
  rw [g,NativePairOrbit.coordinate_from_source]
  exact tube.enclosed NativeCycleFrame30.background_sound initial j

theorem guards_before (n : ℕ) (hn : n < 2*N) :
    ActivePhase (GroundNativePrefixInitial.τ : ℝ)
      (GroundKernelTube.background GroundOriginalFirstTube.originalBackground) (NativeCycleFrame30.κ : ℝ)
      ((g^[n]) GroundOriginalSeed.initial) ∧
    NativeLegal (GroundNativePrefixInitial.τ : ℝ)
      (GroundKernelTube.background GroundOriginalFirstTube.originalBackground) (NativeCycleFrame30.κ : ℝ) (1/2)
      ((g^[n]) GroundOriginalSeed.initial) :=
  NativeOriginalSeedCycleReturn.finite_source_guards tube NativeCycleFrame30.background_sound initial n hn

theorem unit_before (j : Fin (2*N+1)) : complexNormSq ((g^[j.val]) GroundOriginalSeed.initial) = 1 := by
  refine Fin.induction ?_ (fun i _ => ?_) j
  · exact GroundOriginalSeed.initial_unit
  · change complexNormSq ((g^[i.val+1]) GroundOriginalSeed.initial) = 1
    rw [Function.iterate_succ_apply']
    exact GroundNativeEscape.nativeUpdate_unit
      (by exact_mod_cast Step000.threshold_nonneg) (guards_before i.val i.isLt).2

def target : State := NativeCycle30.Step000.transport.center
def centerDistance : ℚ := (1714903256530494206934691926534285260497112315952087/803469022129495137770981046170581301261101496891396417650688)
def entryBound : ℚ := (3429806513060988413869383853068570520994224633160169/1606938044258990275541962092341162602522202993782792835301376)

theorem center_arithmetic : 0 ≤ centerDistance ∧ ∀ i : Fin 8,
    ((Step000.certificate.coordinateBox (differenceBox
      (around (u (Fin.last N)) (v (Fin.last N)) 0 0)
      (around NativeCycle30.Step000.u NativeCycle30.Step000.v 0 0))).R i).bound ≤ centerDistance ∧
    ((Step000.certificate.coordinateBox (differenceBox
      (around (u (Fin.last N)) (v (Fin.last N)) 0 0)
      (around NativeCycle30.Step000.u NativeCycle30.Step000.v 0 0))).I i).bound ≤ centerDistance := by decide +kernel

theorem entry_arithmetic : tube.radii (Fin.last N)+centerDistance ≤ entryBound ∧
    entryBound < NativeCycle30.Step000.ρ := by decide +kernel

theorem center_distance : dist (tube.centers (Fin.last N)) target ≤ (centerDistance : ℝ) := by
  exact coordinate_distance Step000.certificate center_arithmetic.1
    (point_enclosed (u (Fin.last N)) (v (Fin.last N)) (by norm_num : (0 : ℚ) ≤ 0) (by norm_num : (0 : ℚ) ≤ 0))
    (point_enclosed NativeCycle30.Step000.u NativeCycle30.Step000.v (by norm_num : (0 : ℚ) ≤ 0) (by norm_num : (0 : ℚ) ≤ 0))
    center_arithmetic.2

/-- Entry of the actual original complex seed after the certified even prefix.
Neither the seed nor the nonlinear cycle is supplied as an entry hypothesis. -/
theorem original_seed_entry : NativeCycleFrame30.T.symm (unpack ((g^[2*N]) GroundOriginalSeed.initial)) ∈
    closedBall target (NativeCycle30.Step000.ρ : ℝ) := by
  rw [mem_closedBall]
  have h := GroundFiniteNativeTransport.endpoint_distance (source_enclosed_even (Fin.last N)) center_distance
  apply h.trans
  exact_mod_cast entry_arithmetic.1.trans entry_arithmetic.2.le
end
