  decide +kernel
theorem pair_rows : 0 ≤ pairRate ∧ (∀ i : Fin 8, (∑ j : Fin 8,
    (((productCache (j.castAdd 8)).R i).bound+((productCache (Fin.natAdd 8 j)).R i).bound)) ≤ pairRate) ∧
    (∀ i : Fin 8, (∑ j : Fin 8,
    (((productCache (j.castAdd 8)).I i).bound+((productCache (Fin.natAdd 8 j)).I i).bound)) ≤ pairRate) := by decide +kernel
theorem pair_budgets : Step000.next_radius ≤ Step001.ρ ∧ Step000.defect ≤ Step001.ρ ∧
    Step001.rate*Step000.defect+Step001.defect ≤ pairDefect ∧
    pairRate*Step000.ρ+pairDefect ≤ pairRadius := by decide +kernel

def pair : NativePairCertificates.Pair NativeCycleFrame30.B NativeCycleFrame30.κ GroundNativePrefixInitial.τ NativeCycleFrame30.T where
