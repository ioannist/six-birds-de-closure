  Data.f (T := NativeCycleFrame30.T) (κ := NativeCycleFrame30.κ)
    (τ := GroundNativePrefixInitial.τ) (GroundKernelTube.background GroundOriginalFirstTube.originalBackground)

theorem self_defect : dist ((f^[2]) pair.first.center) pair.first.center ≤ (selfDefect : ℝ) := by
  calc
    _ ≤ dist ((f^[2]) pair.first.center) pair.second.nextCenter +
        dist pair.second.nextCenter pair.first.center := dist_triangle _ _ _
    _ ≤ (pairDefect : ℝ)+(centerGap : ℝ) :=
      add_le_add (pair.center_defect NativeCycleFrame30.background_sound) center_gap
    _ = (selfDefect : ℝ) := by norm_num [pairDefect,centerGap,selfDefect]

theorem cycle_budgets : pairRate < 1 ∧ pairRate*Step000.ρ+selfDefect ≤ Step000.ρ ∧
    pairRate*(selfDefect/(1-pairRate))+selfDefect ≤ Step000.ρ ∧
    (Step001.input.R 4).hi < (Step000.input.R 4).lo := by decide +kernel

/-- This constructs an actual source two-cycle; neither phase point is supplied
as a fixed point hypothesis. Full complex neighborhoods retain all 16 columns. -/
theorem actual_cycle : ∃ a ∈ closedBall pair.first.center (Step000.ρ : ℝ),
    (f^[2]) a = a ∧ f a ≠ a ∧ dist a pair.first.center ≤
      (selfDefect : ℝ)/(1-(pairRate : ℝ)) ∧
    ∀ y ∈ closedBall pair.first.center (Step000.ρ : ℝ),
      Filter.Tendsto (fun n : ℕ => (f^[2*n]) y) Filter.atTop (nhds a) ∧
      Filter.Tendsto (fun n : ℕ => (f^[2*n+1]) y) Filter.atTop (nhds (f a)) ∧
      (∀ n : ℕ, dist (((f^[2])^[n]) y) a ≤ (pairRate : ℝ)^n*dist y a) ∧
      ¬ ∃ l, Filter.Tendsto (fun n : ℕ => (f^[n]) y) Filter.atTop (nhds l) := by
  apply NativeActualCycleConstruction.actual_period_two_from_power_certificate (p := 1) f
    (by omega) (by exact_mod_cast Step000.radius_nonneg)
    (by change (pairRate : ℝ) < 1; exact_mod_cast cycle_budgets.1)
    (pair.lipschitz NativeCycleFrame30.background_sound) self_defect
    (by change (pairRate : ℝ)*(Step000.ρ : ℝ)+(selfDefect : ℝ) ≤ (Step000.ρ : ℝ); exact_mod_cast cycle_budgets.2.1)
    (pair.lipschitz NativeCycleFrame30.background_sound) self_defect
    (by change (pairRate : ℝ)*((selfDefect : ℝ)/(1-(pairRate : ℝ)))+(selfDefect : ℝ) ≤ (Step000.ρ : ℝ); exact_mod_cast cycle_budgets.2.2.1)
  · intro a ha
    exact pair.separated NativeCycleFrame30.background_sound cycle_budgets.2.2.2 ha
  · intro a _ j
    have hj : j.val = 0 := by omega
    simp only [hj,Nat.mul_zero,Function.iterate_zero]
    exact continuousAt_id
  · intro a ha
    exact (native_derivative pair.first NativeCycleFrame30.background_sound ha).continuousAt
end
end SbtCosmo.Derivation.NativeCycle30
