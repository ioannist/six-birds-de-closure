theorem first_included : Included Step000.certificate.derivativeBox firstCache := by
  unfold Included StateBox.Included included
  decide +kernel
theorem second_included : Included Step001.certificate.derivativeBox secondCache := by
  unfold Included StateBox.Included included
  decide +kernel
theorem product_included : Included (compose secondCache firstCache) productCache := by
