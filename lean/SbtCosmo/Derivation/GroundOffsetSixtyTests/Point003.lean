theorem ground_arithmetic : GroundBackgroundKernel.Arithmetic
    (GroundUncertainNativeBox.sourceBox (β 3) (κ 3) currentBox) z r q y C := by
  constructor <;> decide +kernel

theorem distance_arithmetic :
    squaredBudget (differenceBox currentBox candidateBox) ≤ d^2 ∧
      squaredBudget (differenceBox currentBox previousBox) ≤ update^2 := by decide +kernel

theorem source_bounds_arithmetic : ∀ j : Fin 8,
    A ≤ (GroundUncertainNativeBox.sourceBox (β 3) (κ 3) currentBox j).lo ∧
      (GroundUncertainNativeBox.sourceBox (β 3) (κ 3) currentBox j).hi ≤ B := by decide +kernel

theorem actual_candidate_enclosed : candidateBox.Contains
    (unpack (-nativeCandidate (GroundOriginalOffsets.rounded_b 3) (κ 3 : ℝ) (orbit 3 60))) := by
  have hx := GroundOffsetSixtyPrefix.Point003.current_enclosed
  have hg := GroundBackgroundKernel.actual_selected_enclosed ground_arithmetic
    (GroundUncertainNativeBox.sourceBox_sound (β 3) (κ 3) (background_sound 3) hx)
  have he := nativeCandidate_pack (GroundOriginalOffsets.rounded_b 3) (κ 3 : ℝ) (unpack (orbit 3 60))
  rw [show pack (unpack (orbit 3 60)) = orbit 3 60 from packCLE.apply_symm_apply _] at he
  rw [he, ← GroundNativeReflection.realEmbed_neg]
  exact negativeTargetBox_sound hg

theorem actual_candidate_distance :
    l2 (orbit 3 60-(-nativeCandidate (GroundOriginalOffsets.rounded_b 3) (κ 3 : ℝ) (orbit 3 60))) ≤ (d : ℝ) := by
  have hx : (differenceBox currentBox candidateBox).Contains
      (unpack (orbit 3 60-(-nativeCandidate (GroundOriginalOffsets.rounded_b 3) (κ 3 : ℝ) (orbit 3 60)))) := by
    simpa only [← packCLE_symm_apply,map_sub] using
      differenceBox_sound GroundOffsetSixtyPrefix.Point003.current_enclosed actual_candidate_enclosed
  exact box_l2_bound hx (by decide +kernel) distance_arithmetic.1

theorem actual_update_distance : l2 (orbit 3 60-orbit 3 59) ≤ (update : ℝ) := by
  have hx : (differenceBox currentBox previousBox).Contains (unpack (orbit 3 60-orbit 3 59)) := by
    simpa only [← packCLE_symm_apply,map_sub] using
      differenceBox_sound GroundOffsetSixtyPrefix.Point003.current_enclosed GroundOffsetSixtyPrefix.Point003.previous_enclosed
  exact box_l2_bound hx (by decide +kernel) distance_arithmetic.2

theorem actual_potential_bounds : ∀ j,
    (A : ℝ) ≤ complexSourcePotential (GroundOriginalOffsets.rounded_b 3) (κ 3 : ℝ) (orbit 3 60) j ∧
      complexSourcePotential (GroundOriginalOffsets.rounded_b 3) (κ 3 : ℝ) (orbit 3 60) j ≤ (B : ℝ) := by
  have hp := source_pack (GroundOriginalOffsets.rounded_b 3) (κ 3 : ℝ) (unpack (orbit 3 60))
  rw [show pack (unpack (orbit 3 60)) = orbit 3 60 from packCLE.apply_symm_apply _] at hp
  intro j
  have hs := GroundUncertainNativeBox.sourceBox_sound (β 3) (κ 3) (background_sound 3) GroundOffsetSixtyPrefix.Point003.current_enclosed j
  rw [← hp] at hs
  exact ⟨(Rat.cast_le.mpr (source_bounds_arithmetic j).1).trans hs.1,
    hs.2.trans (Rat.cast_le.mpr (source_bounds_arithmetic j).2)⟩

theorem actual_four_source_tests : MeetsConvergence GroundNativeControls.originalTolerance
    GroundOriginalResiduals.ε (GroundOriginalOffsets.rounded_b 3) (κ 3 : ℝ) (1/2)
      (orbit 3 59) (orbit 3 60) := by
