theorem actual_candidate_enclosed : candidateBox.Contains
    (unpack (-nativeCandidate (GroundOriginalOffsets.rounded_b 16) (κ 16 : ℝ) (orbit 16 60))) := by
  have hx := GroundOffsetSixtyPrefix.Point016.current_enclosed
  have hg := GroundBackgroundKernel.actual_selected_enclosed ground_arithmetic
    (GroundUncertainNativeBox.sourceBox_sound (β 16) (κ 16) (background_sound 16) hx)
  have he := nativeCandidate_pack (GroundOriginalOffsets.rounded_b 16) (κ 16 : ℝ) (unpack (orbit 16 60))
  rw [show pack (unpack (orbit 16 60)) = orbit 16 60 from packCLE.apply_symm_apply _] at he
  rw [he, ← GroundNativeReflection.realEmbed_neg]
  exact negativeTargetBox_sound hg

theorem actual_candidate_distance :
    l2 (orbit 16 60-(-nativeCandidate (GroundOriginalOffsets.rounded_b 16) (κ 16 : ℝ) (orbit 16 60))) ≤ (d : ℝ) := by
  have hx : (differenceBox currentBox candidateBox).Contains
      (unpack (orbit 16 60-(-nativeCandidate (GroundOriginalOffsets.rounded_b 16) (κ 16 : ℝ) (orbit 16 60)))) := by
    simpa only [← packCLE_symm_apply,map_sub] using
      differenceBox_sound GroundOffsetSixtyPrefix.Point016.current_enclosed actual_candidate_enclosed
  exact box_l2_bound hx (by decide +kernel) distance_arithmetic.1

theorem actual_update_distance : l2 (orbit 16 60-orbit 16 59) ≤ (update : ℝ) := by
  have hx : (differenceBox currentBox previousBox).Contains (unpack (orbit 16 60-orbit 16 59)) := by
    simpa only [← packCLE_symm_apply,map_sub] using
      differenceBox_sound GroundOffsetSixtyPrefix.Point016.current_enclosed GroundOffsetSixtyPrefix.Point016.previous_enclosed
  exact box_l2_bound hx (by decide +kernel) distance_arithmetic.2

theorem actual_potential_bounds : ∀ j,
    (A : ℝ) ≤ complexSourcePotential (GroundOriginalOffsets.rounded_b 16) (κ 16 : ℝ) (orbit 16 60) j ∧
      complexSourcePotential (GroundOriginalOffsets.rounded_b 16) (κ 16 : ℝ) (orbit 16 60) j ≤ (B : ℝ) := by
  have hp := source_pack (GroundOriginalOffsets.rounded_b 16) (κ 16 : ℝ) (unpack (orbit 16 60))
  rw [show pack (unpack (orbit 16 60)) = orbit 16 60 from packCLE.apply_symm_apply _] at hp
  intro j
  have hs := GroundUncertainNativeBox.sourceBox_sound (β 16) (κ 16) (background_sound 16) GroundOffsetSixtyPrefix.Point016.current_enclosed j
  rw [← hp] at hs
  exact ⟨(Rat.cast_le.mpr (source_bounds_arithmetic j).1).trans hs.1,
    hs.2.trans (Rat.cast_le.mpr (source_bounds_arithmetic j).2)⟩

