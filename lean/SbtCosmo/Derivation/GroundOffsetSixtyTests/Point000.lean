theorem ground_arithmetic : GroundBackgroundKernel.Arithmetic
    (GroundUncertainNativeBox.sourceBox (β 0) (κ 0) currentBox) z r q y C := by
  constructor <;> decide +kernel

theorem distance_arithmetic :
    squaredBudget (differenceBox currentBox candidateBox) ≤ d^2 ∧
      squaredBudget (differenceBox currentBox previousBox) ≤ update^2 := by decide +kernel

theorem source_bounds_arithmetic : ∀ j : Fin 8,
    A ≤ (GroundUncertainNativeBox.sourceBox (β 0) (κ 0) currentBox j).lo ∧
      (GroundUncertainNativeBox.sourceBox (β 0) (κ 0) currentBox j).hi ≤ B := by decide +kernel

theorem actual_candidate_enclosed : candidateBox.Contains
    (unpack (-nativeCandidate (GroundOriginalOffsets.rounded_b 0) (κ 0 : ℝ) (orbit 0 60))) := by
  have hx := GroundOffsetSixtyPrefix.Point000.current_enclosed
  have hg := GroundBackgroundKernel.actual_selected_enclosed ground_arithmetic
    (GroundUncertainNativeBox.sourceBox_sound (β 0) (κ 0) (background_sound 0) hx)
  have he := nativeCandidate_pack (GroundOriginalOffsets.rounded_b 0) (κ 0 : ℝ) (unpack (orbit 0 60))
  rw [show pack (unpack (orbit 0 60)) = orbit 0 60 from packCLE.apply_symm_apply _] at he
  rw [he, ← GroundNativeReflection.realEmbed_neg]
  exact negativeTargetBox_sound hg

theorem actual_candidate_distance :
    l2 (orbit 0 60-(-nativeCandidate (GroundOriginalOffsets.rounded_b 0) (κ 0 : ℝ) (orbit 0 60))) ≤ (d : ℝ) := by
  have hx : (differenceBox currentBox candidateBox).Contains
      (unpack (orbit 0 60-(-nativeCandidate (GroundOriginalOffsets.rounded_b 0) (κ 0 : ℝ) (orbit 0 60)))) := by
    simpa only [← packCLE_symm_apply,map_sub] using
      differenceBox_sound GroundOffsetSixtyPrefix.Point000.current_enclosed actual_candidate_enclosed
  exact box_l2_bound hx (by decide +kernel) distance_arithmetic.1

theorem actual_update_distance : l2 (orbit 0 60-orbit 0 59) ≤ (update : ℝ) := by
  have hx : (differenceBox currentBox previousBox).Contains (unpack (orbit 0 60-orbit 0 59)) := by
    simpa only [← packCLE_symm_apply,map_sub] using
      differenceBox_sound GroundOffsetSixtyPrefix.Point000.current_enclosed GroundOffsetSixtyPrefix.Point000.previous_enclosed
  exact box_l2_bound hx (by decide +kernel) distance_arithmetic.2

theorem actual_potential_bounds : ∀ j,
    (A : ℝ) ≤ complexSourcePotential (GroundOriginalOffsets.rounded_b 0) (κ 0 : ℝ) (orbit 0 60) j ∧
      complexSourcePotential (GroundOriginalOffsets.rounded_b 0) (κ 0 : ℝ) (orbit 0 60) j ≤ (B : ℝ) := by
  have hp := source_pack (GroundOriginalOffsets.rounded_b 0) (κ 0 : ℝ) (unpack (orbit 0 60))
  rw [show pack (unpack (orbit 0 60)) = orbit 0 60 from packCLE.apply_symm_apply _] at hp
  intro j
  have hs := GroundUncertainNativeBox.sourceBox_sound (β 0) (κ 0) (background_sound 0) GroundOffsetSixtyPrefix.Point000.current_enclosed j
  rw [← hp] at hs
  exact ⟨(Rat.cast_le.mpr (source_bounds_arithmetic j).1).trans hs.1,
    hs.2.trans (Rat.cast_le.mpr (source_bounds_arithmetic j).2)⟩

