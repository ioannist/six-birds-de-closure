theorem initial_arithmetic : 0 ≤ initialRadius ∧ ∀ j : Fin 8,
    ((NativeStable006Arithmetic.certificate.coordinateBox (differenceBox GroundOffsetPrefixInitial.initialBox
      (around initial_u initial_v 0 0))).R j).bound ≤ initialRadius ∧
    ((NativeStable006Arithmetic.certificate.coordinateBox (differenceBox GroundOffsetPrefixInitial.initialBox
      (around initial_u initial_v 0 0))).I j).bound ≤ initialRadius := by decide +kernel

/-- Earned enclosure of the actual source seed, including both initial normalizations. -/
theorem original_seed_enclosed : NativeStableFrame006.T.symm (unpack GroundOriginalSeed.initial) ∈
    closedBall initialCenter (initialRadius : ℝ) := by
  rw [mem_closedBall]
  exact coordinate_distance NativeStable006Arithmetic.certificate initial_arithmetic.1
    GroundOffsetPrefixInitial.original_seed_enclosed
    (point_enclosed initial_u initial_v (by norm_num : (0 : ℚ) ≤ 0) (by norm_num : (0 : ℚ) ≤ 0))
    initial_arithmetic.2

theorem center_arithmetic : 0 ≤ centerDistance ∧ ∀ j : Fin 8,
    ((NativeStable006Arithmetic.certificate.coordinateBox (differenceBox (around endpoint_u endpoint_v 0 0)
      (negativeTargetBox NativeStableFrame006.z NativeStableFrame006.r))).R j).bound ≤ centerDistance ∧
    ((NativeStable006Arithmetic.certificate.coordinateBox (differenceBox (around endpoint_u endpoint_v 0 0)
      (negativeTargetBox NativeStableFrame006.z NativeStableFrame006.r))).I j).bound ≤ centerDistance := by decide +kernel

theorem center_distance : dist endpointCenter actualTarget ≤ (centerDistance : ℝ) := by
  exact coordinate_distance NativeStable006Arithmetic.certificate center_arithmetic.1
    (point_enclosed endpoint_u endpoint_v (by norm_num : (0 : ℚ) ≤ 0) (by norm_num : (0 : ℚ) ≤ 0))
    (negativeTargetBox_sound NativeStableFrame006.root_enclosed) center_arithmetic.2

theorem entry_arithmetic : 0 ≤ endpointRadius ∧ endpointRadius+centerDistance ≤ entryBound ∧
    entryBound < NativeStable006Arithmetic.ρ := by decide +kernel

/-- Only the endpoint geometry. The actual finite orbit enclosure is a separate obligation. -/
theorem actual_root_entry_of_enclosure {z : ComplexField}
    (hz : NativeStableFrame006.T.symm (unpack z) ∈ closedBall endpointCenter (endpointRadius : ℝ)) :
    NativeStableFrame006.T.symm (unpack z) ∈ closedBall actualTarget (NativeStable006Arithmetic.ρ : ℝ) := by
  rw [mem_closedBall]
  have h := GroundFiniteNativeTransport.endpoint_distance hz center_distance
  apply h.trans
  exact_mod_cast entry_arithmetic.2.1.trans entry_arithmetic.2.2.le
end
