SbtCosmo.Derivation.GroundSourceNormalizationFailure.exists_phase_execution_split
  (b : SbtCosmo.Derivation.GroundState.Field) (κ : ℝ) {τ : ℝ} (hτ0 : 0 ≤ τ) (hτ1 : τ < 1) :
  ∃ a z,
    (z = fun j => Complex.I * a j) ∧
      SbtCosmo.Derivation.GroundState.complexNormSq a = 1 ∧
        SbtCosmo.Derivation.GroundState.complexNormSq z = 1 ∧
          (∀ (j : Fin 8), Complex.normSq (a j) = Complex.normSq (z j)) ∧
            SbtCosmo.Derivation.GroundState.complexSourcePotential b κ a =
                SbtCosmo.Derivation.GroundState.complexSourcePotential b κ z ∧
              SbtCosmo.Derivation.GroundSourceNormalization.run τ
                    (SbtCosmo.Derivation.GroundNativeIteration.nativeMixed τ b κ (1 / 2)) a 1 =
                  some a ∧
                SbtCosmo.Derivation.GroundSourceNormalization.run τ
                      (SbtCosmo.Derivation.GroundNativeIteration.nativeMixed τ b κ (1 / 2)) z 1 =
                    none ∧
                  ∀ (N : ℕ),
                    0 < N →
                      SbtCosmo.Derivation.GroundSourceNormalization.run τ
                          (SbtCosmo.Derivation.GroundNativeIteration.nativeMixed τ b κ (1 / 2)) z N =
                        none
