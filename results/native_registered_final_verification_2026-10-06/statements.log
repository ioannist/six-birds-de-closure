SbtCosmo.Derivation.GroundOriginalCycle30BasinBridge.source_returns_of_squared_limit
  {p : SbtCosmo.Derivation.GroundOriginalCycle30Baseline.Parameter} {x v : SbtCosmo.Derivation.GroundNativePhase.State}
  (he :
    Filter.Tendsto (fun n => (SbtCosmo.Derivation.GroundOriginalCycle30Baseline.map p)^[2] ^[n] x) Filter.atTop
      (nhds v))
  (hg : (p, v) ∈ SbtCosmo.Derivation.GroundOriginalCycle30Baseline.guard) :
