  (f : α → α) {k : ℕ} {a c : α} {R r d : ℝ} {M : NNReal} (hfix : f^[k] a = a) (hR : 0 ≤ R)
  (ha : a ∈ Metric.closedBall c R) (huniq : ∀ x ∈ Metric.closedBall c R, f^[k] x = x → x = a) (hinner : dist a c ≤ r)
  (hLip : LipschitzOnWith M f^[2] (Metric.closedBall c R)) (hdefect : dist (f^[2] c) c ≤ d) (hbudget : ↑M * r + d ≤ R) :
  f^[2] a = a
