NativeActualCycleConstruction.actual_period_two_from_power_certificate.{u_1} {α : Type u_1} [MetricSpace α]
  [CompleteSpace α] (f : α → α) {c : α} {p : ℕ} {R d d₂ : ℝ} {q M : NNReal} (hp : 0 < p) (hR : 0 ≤ R) (hq : q < 1)
  (hL : LipschitzOnWith q f^[2 * p] (Metric.closedBall c R)) (hd : dist (f^[2 * p] c) c ≤ d) (hbudget : ↑q * R + d ≤ R)
  (hL₂ : LipschitzOnWith M f^[2] (Metric.closedBall c R)) (hd₂ : dist (f^[2] c) c ≤ d₂)
  (hinner_budget : ↑M * (d / (1 - ↑q)) + d₂ ≤ R) (hsep : ∀ a ∈ Metric.closedBall c R, f a ≠ a)
  (hcont : ∀ a ∈ Metric.closedBall c R, ∀ (j : Fin p), ContinuousAt f^[2 * ↑j] a)
  (hstep : ∀ a ∈ Metric.closedBall c R, ContinuousAt f a) :
  ∃ a ∈ Metric.closedBall c R,
    f^[2] a = a ∧
      f a ≠ a ∧
        dist a c ≤ d / (1 - ↑q) ∧
          ∀ y ∈ Metric.closedBall c R,
            Filter.Tendsto (fun n => f^[2 * n] y) Filter.atTop (nhds a) ∧
              Filter.Tendsto (fun n => f^[2 * n + 1] y) Filter.atTop (nhds (f a)) ∧
                (∀ (n : ℕ), dist (f^[2 * p] ^[n] y) a ≤ ↑q ^ n * dist y a) ∧
                  ¬∃ l, Filter.Tendsto (fun n => f^[n] y) Filter.atTop (nhds l)
