  Filter.Tendsto g Filter.atTop (nhds a)
NativeCycleSubsequences.even_odd_returns.{u_1} {α : Type u_1} [TopologicalSpace α] (f : α → α) {a y : α} {p : ℕ}
  (hp : 0 < p) (h2 : f^[2] a = a) (hpower : Filter.Tendsto (fun n => f^[2 * p] ^[n] y) Filter.atTop (nhds a))
  (hcont : ∀ (j : Fin p), ContinuousAt f^[2 * ↑j] a) (hstep : ContinuousAt f a) :
  Filter.Tendsto (fun n => f^[2 * n] y) Filter.atTop (nhds a) ∧
    Filter.Tendsto (fun n => f^[2 * n + 1] y) Filter.atTop (nhds (f a))
NativeCycleSubsequences.nonconvergence_of_distinct_limits.{u_1} {α : Type u_1} [TopologicalSpace α] [T2Space α]
  (f : α → α) {a y : α} (he : Filter.Tendsto (fun n => f^[2 * n] y) Filter.atTop (nhds a))
  (ho : Filter.Tendsto (fun n => f^[2 * n + 1] y) Filter.atTop (nhds (f a))) (hne : f a ≠ a) :
