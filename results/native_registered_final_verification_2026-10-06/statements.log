  [NormedAddCommGroup P] [NormedSpace ℝ P] [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E] {f : P → E → E}
  {p : P} {u : E} {s : Set (P × E)} (hc : ContDiffAt ℝ 1 (Function.uncurry f) (p, u)) (hf : f p u = u)
  (hd : ‖fderiv ℝ (f p) u‖ < 1) (hs : s ∈ nhds (p, u)) :
