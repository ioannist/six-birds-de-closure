                                            (↑SbtCosmo.Derivation.GroundNativePrefixInitial.τ) p.1 p.2 (1 / 2)
                                            ((SbtCosmo.Derivation.GroundOriginalCycle30OpenReturn.native p)^[n]
                                              SbtCosmo.Derivation.GroundOriginalSeed.initial) ∧
                                          SbtCosmo.Derivation.GroundState.complexNormSq
                                              ((SbtCosmo.Derivation.GroundOriginalCycle30OpenReturn.native p)^[n]
                                                SbtCosmo.Derivation.GroundOriginalSeed.initial) =
                                            1) ∧
                                    ∀ (z : SbtCosmo.Derivation.GroundState.ComplexField),
                                      SbtCosmo.Derivation.GroundOriginalCycle30BasinBridge.decode z ∈
                                          Metric.closedBall a r →
                                        Filter.Tendsto
                                            (fun n =>
                                              (SbtCosmo.Derivation.GroundOriginalCycle30OpenReturn.native p)^[2 * n] z)
                                            Filter.atTop (nhds z₀) ∧
                                          Filter.Tendsto
                                              (fun n =>
                                                (SbtCosmo.Derivation.GroundOriginalCycle30OpenReturn.native
                                                      p)^[2 * n + 1]
                                                  z)
                                              Filter.atTop (nhds z₁) ∧
                                            (∀ (n : ℕ),
                                                SbtCosmo.Derivation.GroundNativeIteration.ActivePhase
                                                    (↑SbtCosmo.Derivation.GroundNativePrefixInitial.τ) p.1 p.2
                                                    ((SbtCosmo.Derivation.GroundOriginalCycle30OpenReturn.native p)^[n]
                                                      z) ∧
                                                  SbtCosmo.Derivation.GroundNativeIteration.NativeLegal
                                                    (↑SbtCosmo.Derivation.GroundNativePrefixInitial.τ) p.1 p.2 (1 / 2)
                                                    ((SbtCosmo.Derivation.GroundOriginalCycle30OpenReturn.native p)^[n]
                                                      z)) ∧
                                              ∀ (n : ℕ),
                                                SbtCosmo.Derivation.GroundState.complexNormSq
                                                    ((SbtCosmo.Derivation.GroundOriginalCycle30OpenReturn.native
                                                          p)^[n + 1]
                                                      z) =
                                                  1
SbtCosmo.Derivation.GroundOriginalCycle30TwoPhaseBasin.shifted_landing
  {p : SbtCosmo.Derivation.GroundOriginalCycle30Baseline.Parameter}
  {z₀ z₁ z : SbtCosmo.Derivation.GroundState.ComplexField}
  (hg : SbtCosmo.Derivation.GroundOriginalCycle30TwoPhaseBasin.Guard p z)
  (h :
    SbtCosmo.Derivation.GroundOriginalCycle30TwoPhaseBasin.Landing p z₀ z₁
      (SbtCosmo.Derivation.GroundOriginalCycle30OpenReturn.native p z)) :
  SbtCosmo.Derivation.GroundOriginalCycle30TwoPhaseBasin.Landing p z₁ z₀ z
SbtCosmo.Derivation.GroundOriginalCycle30TwoPhaseBasin.opposite_phase_neighborhood
  {p : SbtCosmo.Derivation.GroundOriginalCycle30Baseline.Parameter}
  {z₀ z₁ : SbtCosmo.Derivation.GroundState.ComplexField}
  (h01 : SbtCosmo.Derivation.GroundOriginalCycle30OpenReturn.native p z₀ = z₁)
  (h10 : SbtCosmo.Derivation.GroundOriginalCycle30OpenReturn.native p z₁ = z₀)
  {s₀ : Set SbtCosmo.Derivation.GroundState.ComplexField} (hs₀ : s₀ ∈ nhds z₀)
  (hlocal : ∀ z ∈ s₀, SbtCosmo.Derivation.GroundOriginalCycle30TwoPhaseBasin.Landing p z₀ z₁ z) :
  ∃ s₁ ∈ nhds z₁, ∀ z ∈ s₁, SbtCosmo.Derivation.GroundOriginalCycle30TwoPhaseBasin.Landing p z₁ z₀ z
SbtCosmo.Derivation.GroundOriginalCycle30TwoPhaseBasin.open_both_phases_attracting_cycle :
  ∃ δ > 0,
    ∀ p ∈ Metric.closedBall SbtCosmo.Derivation.GroundOriginalCycle30Baseline.baseline δ,
      ∃ z₀ z₁,
        SbtCosmo.Derivation.NativeRealProfiles.IsReal z₀ ∧
          SbtCosmo.Derivation.NativeRealProfiles.IsReal z₁ ∧
            SbtCosmo.Derivation.GroundOriginalCycle30OpenReturn.native p z₀ = z₁ ∧
              SbtCosmo.Derivation.GroundOriginalCycle30OpenReturn.native p z₁ = z₀ ∧
                SbtCosmo.Derivation.GroundState.complexNormSq z₀ = 1 ∧
                  SbtCosmo.Derivation.GroundState.complexNormSq z₁ = 1 ∧
                    9 / 20 < Complex.normSq (z₁ 4) - Complex.normSq (z₀ 4) ∧
                      SbtCosmo.Derivation.GroundOriginalCycle30TwoPhaseBasin.Landing p z₀ z₁
                          SbtCosmo.Derivation.GroundOriginalSeed.initial ∧
                        (∀ (n : ℕ),
                            SbtCosmo.Derivation.GroundState.complexNormSq
                                ((SbtCosmo.Derivation.GroundOriginalCycle30OpenReturn.native p)^[n]
                                  SbtCosmo.Derivation.GroundOriginalSeed.initial) =
                              1) ∧
                          ∃ s₀ s₁,
                            s₀ ∈ nhds z₀ ∧
                              s₁ ∈ nhds z₁ ∧
                                (∀ z ∈ s₀, SbtCosmo.Derivation.GroundOriginalCycle30TwoPhaseBasin.Landing p z₀ z₁ z) ∧
                                  ∀ z ∈ s₁, SbtCosmo.Derivation.GroundOriginalCycle30TwoPhaseBasin.Landing p z₁ z₀ z
SbtCosmo.Derivation.GroundOriginalOpenBackground.rounded_newton_defect (i : Fin 18) :
  ‖SbtCosmo.Derivation.GroundRootCertificate.correctionDerivative
        (SbtCosmo.Derivation.GroundOriginalOffsets.rounded_b i)
        (↑(SbtCosmo.Derivation.GroundOriginalOffsets.certificates i).κ)
        (SbtCosmo.Derivation.GroundResidualEnclosure.preconditioner
          (SbtCosmo.Derivation.GroundOriginalOffsets.certificates i).C)
        (SbtCosmo.Derivation.GroundOriginalOffsets.roundedRoot i)‖ <
    1
SbtCosmo.Derivation.GroundOriginalOpenBackground.localPoint_center (i : Fin 18) :
  SbtCosmo.Derivation.GroundOriginalOpenBackground.localPoint i
      (SbtCosmo.Derivation.GroundOriginalOffsets.rounded_b i) =
    SbtCosmo.Derivation.GroundOriginalOffsets.roundedRoot i
SbtCosmo.Derivation.GroundOriginalOpenBackground.localPoint_smooth_at (i : Fin 18) :
  ContDiffAt ℝ (↑⊤) (SbtCosmo.Derivation.GroundOriginalOpenBackground.localPoint i)
    (SbtCosmo.Derivation.GroundOriginalOffsets.rounded_b i)
SbtCosmo.Derivation.GroundOriginalOpenBackground.localPoint_ground_eventually (i : Fin 18) :
  ∀ᶠ (b : SbtCosmo.Derivation.GroundState.Field) in nhds (SbtCosmo.Derivation.GroundOriginalOffsets.rounded_b i),
    SbtCosmo.Derivation.GroundRootCertificate.residual b (↑(SbtCosmo.Derivation.GroundOriginalOffsets.certificates i).κ)
          (SbtCosmo.Derivation.GroundOriginalOpenBackground.localPoint i b) =
        0 ∧
      (∀ (j : Fin 8), 0 < (SbtCosmo.Derivation.GroundOriginalOpenBackground.localPoint i b).1 j) ∧
        SbtCosmo.Derivation.GroundState.normSq (SbtCosmo.Derivation.GroundOriginalOpenBackground.localPoint i b).1 = 1 ∧
          SbtCosmo.Derivation.GroundBorder.groundPair
                (SbtCosmo.Derivation.GroundState.sourcePotential b
                  (↑(SbtCosmo.Derivation.GroundOriginalOffsets.certificates i).κ)
                  (SbtCosmo.Derivation.GroundOriginalOpenBackground.localPoint i b).1) =
              SbtCosmo.Derivation.GroundOriginalOpenBackground.localPoint i b ∧
            SbtCosmo.Derivation.GroundSourceJacobian.groundMap b
                (↑(SbtCosmo.Derivation.GroundOriginalOffsets.certificates i).κ)
                (SbtCosmo.Derivation.GroundOriginalOpenBackground.localPoint i b).1 =
              (SbtCosmo.Derivation.GroundOriginalOpenBackground.localPoint i b).1
SbtCosmo.Derivation.GroundOriginalOpenBackground.rounded_coordinate_contraction (i : Fin 18) :
  ‖SbtCosmo.Derivation.GroundNativeLocal.coordinateDerivative
        (SbtCosmo.Derivation.GroundOriginalOffsetStability.fullBasis i)
        (SbtCosmo.Derivation.GroundOriginalOffsets.rounded_b i)
        (↑(SbtCosmo.Derivation.GroundOriginalOffsets.certificates i).κ) (1 / 2)
        (SbtCosmo.Derivation.GroundOriginalOffsets.roundedRoot i).1‖ <
    1
SbtCosmo.Derivation.GroundOriginalOpenBackground.open_background_original_seed_return (i : Fin 18) :
  ∃ δ > 0,
    ∀ b ∈ Metric.closedBall (SbtCosmo.Derivation.GroundOriginalOffsets.rounded_b i) δ,
      SbtCosmo.Derivation.GroundRootCertificate.residual b
            (↑(SbtCosmo.Derivation.GroundOriginalOffsets.certificates i).κ)
            (SbtCosmo.Derivation.GroundOriginalOpenBackground.localPoint i b) =
          0 ∧
        (∀ (j : Fin 8), 0 < (SbtCosmo.Derivation.GroundOriginalOpenBackground.localPoint i b).1 j) ∧
          SbtCosmo.Derivation.GroundState.normSq (SbtCosmo.Derivation.GroundOriginalOpenBackground.localPoint i b).1 =
              1 ∧
            SbtCosmo.Derivation.GroundBorder.groundPair
                  (SbtCosmo.Derivation.GroundState.sourcePotential b
                    (↑(SbtCosmo.Derivation.GroundOriginalOffsets.certificates i).κ)
                    (SbtCosmo.Derivation.GroundOriginalOpenBackground.localPoint i b).1) =
                SbtCosmo.Derivation.GroundOriginalOpenBackground.localPoint i b ∧
              SbtCosmo.Derivation.GroundSourceJacobian.groundMap b
                    (↑(SbtCosmo.Derivation.GroundOriginalOffsets.certificates i).κ)
                    (SbtCosmo.Derivation.GroundOriginalOpenBackground.localPoint i b).1 =
                  (SbtCosmo.Derivation.GroundOriginalOpenBackground.localPoint i b).1 ∧
                Filter.Tendsto
                    (fun n =>
                      (SbtCosmo.Derivation.GroundNativeIteration.nativeUpdate
                            SbtCosmo.Derivation.GroundNativeControls.originalTolerance b
                            (↑(SbtCosmo.Derivation.GroundOriginalOffsets.certificates i).κ) (1 / 2))^[n]
                        SbtCosmo.Derivation.GroundOriginalSeed.initial)
                    Filter.atTop
                    (nhds
                      (SbtCosmo.Derivation.GroundState.realEmbed
                        (-(SbtCosmo.Derivation.GroundOriginalOpenBackground.localPoint i b).1))) ∧
                  ∀ (n : ℕ),
                    SbtCosmo.Derivation.GroundNativeIteration.ActivePhase
                        SbtCosmo.Derivation.GroundNativeControls.originalTolerance b
                        (↑(SbtCosmo.Derivation.GroundOriginalOffsets.certificates i).κ)
                        ((SbtCosmo.Derivation.GroundNativeIteration.nativeUpdate
                              SbtCosmo.Derivation.GroundNativeControls.originalTolerance b
                              (↑(SbtCosmo.Derivation.GroundOriginalOffsets.certificates i).κ) (1 / 2))^[n]
                          SbtCosmo.Derivation.GroundOriginalSeed.initial) ∧
                      SbtCosmo.Derivation.GroundNativeIteration.NativeLegal
                          SbtCosmo.Derivation.GroundNativeControls.originalTolerance b
                          (↑(SbtCosmo.Derivation.GroundOriginalOffsets.certificates i).κ) (1 / 2)
                          ((SbtCosmo.Derivation.GroundNativeIteration.nativeUpdate
                                SbtCosmo.Derivation.GroundNativeControls.originalTolerance b
                                (↑(SbtCosmo.Derivation.GroundOriginalOffsets.certificates i).κ) (1 / 2))^[n]
                            SbtCosmo.Derivation.GroundOriginalSeed.initial) ∧
                        SbtCosmo.Derivation.GroundState.complexNormSq
                            ((SbtCosmo.Derivation.GroundNativeIteration.nativeUpdate
                                  SbtCosmo.Derivation.GroundNativeControls.originalTolerance b
                                  (↑(SbtCosmo.Derivation.GroundOriginalOffsets.certificates i).κ) (1 / 2))^[n]
                              SbtCosmo.Derivation.GroundOriginalSeed.initial) =
                          1
SbtCosmo.Derivation.GroundOriginalOpenBackgroundReadout.density_continuous_at (i : Fin 18) (j : Fin 8) :
  ContinuousAt (fun b => SbtCosmo.Derivation.GroundOriginalOpenBackgroundReadout.density i b j)
    (SbtCosmo.Derivation.GroundOriginalOffsets.rounded_b i)
SbtCosmo.Derivation.GroundOriginalOpenBackgroundReadout.density_center (i : Fin 18) (j : Fin 8) :
  SbtCosmo.Derivation.GroundOriginalOpenBackgroundReadout.density i
      (SbtCosmo.Derivation.GroundOriginalOffsets.rounded_b i) j =
    Complex.normSq
      (SbtCosmo.Derivation.GroundState.realEmbed (SbtCosmo.Derivation.GroundOriginalOffsets.roundedRoot i).1 j)
SbtCosmo.Derivation.GroundOriginalOpenBackgroundReadout.open_background_density_limits (i : Fin 18) :
  ∃ δ > 0,
    ∀ b ∈ Metric.closedBall (SbtCosmo.Derivation.GroundOriginalOffsets.rounded_b i) δ,
      ∀ (j : Fin 8),
        Filter.Tendsto (fun n => Complex.normSq (SbtCosmo.Derivation.GroundOriginalOpenBackgroundReadout.orbit i b n j))
          Filter.atTop (nhds (SbtCosmo.Derivation.GroundOriginalOpenBackgroundReadout.density i b j))
SbtCosmo.Derivation.GroundOriginalOpenBackgroundReadout.open_endpoint_density_separation :
  ∃ δ > 0,
    ∀ b₀ ∈ Metric.closedBall (SbtCosmo.Derivation.GroundOriginalOffsets.rounded_b 0) δ,
      ∀ b₁ ∈ Metric.closedBall (SbtCosmo.Derivation.GroundOriginalOffsets.rounded_b 17) δ,
        ∀ᶠ (n : ℕ) in Filter.atTop,
          Complex.normSq (SbtCosmo.Derivation.GroundOriginalOpenBackgroundReadout.orbit 0 b₀ n 0) + 9 / 100 <
            Complex.normSq (SbtCosmo.Derivation.GroundOriginalOpenBackgroundReadout.orbit 17 b₁ n 0)
SbtCosmo.Derivation.GroundParametricBranchReturn.nearby_original_seed_branch_returns.{u_1, u_2} {P : Type u_1}
  {E : Type u_2} [NormedAddCommGroup P] [NormedSpace ℝ P] [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E]
  {f : P → E → E} {p : P} {u a : E} {s : Set (P × E)} {g : P → E} (hc : ContDiffAt ℝ 1 (Function.uncurry f) (p, u))
  (hf : f p u = u) (hd : ‖fderiv ℝ (f p) u‖ < 1) (hs : s ∈ nhds (p, u))
  (horbit : ∀ (n : ℕ), ContinuousAt (Function.uncurry f) (p, (f p)^[n] a))
  (hguards : ∀ (n : ℕ), s ∈ nhds (p, (f p)^[n] a)) (hlim : Filter.Tendsto (fun n => (f p)^[n] a) Filter.atTop (nhds u))
  (hg : ContinuousAt g p) (hg0 : g p = u) (hgfix : ∀ᶠ (b : P) in nhds p, f b (g b) = g b) :
  ∃ δ > 0,
    ∀ b ∈ Metric.closedBall p δ,
      Filter.Tendsto (fun n => (f b)^[n] a) Filter.atTop (nhds (g b)) ∧ ∀ (n : ℕ), (b, (f b)^[n] a) ∈ s
SbtCosmo.Derivation.GroundParametricContraction.partial_fderiv_continuous_at.{u_1, u_2} {P : Type u_1} {E : Type u_2}
  [NormedAddCommGroup P] [NormedSpace ℝ P] [NormedAddCommGroup E] [NormedSpace ℝ E] {f : P → E → E} {p : P} {u : E}
  (hc : ContDiffAt ℝ 1 (Function.uncurry f) (p, u)) : ContinuousAt (fun v => fderiv ℝ (f v.1) v.2) (p, u)
SbtCosmo.Derivation.GroundParametricContraction.uniform_local_lipschitz.{u_1, u_2} {P : Type u_1} {E : Type u_2}
  [NormedAddCommGroup P] [NormedSpace ℝ P] [NormedAddCommGroup E] [NormedSpace ℝ E] {f : P → E → E} {p : P} {u : E}
  {s : Set (P × E)} (hc : ContDiffAt ℝ 1 (Function.uncurry f) (p, u)) (hd : ‖fderiv ℝ (f p) u‖ < 1)
  (hs : s ∈ nhds (p, u)) :
  ∃ δ > 0,
    ∃ r > 0,
      ∃ q < 1,
        ∀ b ∈ Metric.closedBall p δ,
          LipschitzOnWith q (f b) (Metric.closedBall u r) ∧ ∀ x ∈ Metric.closedBall u r, (b, x) ∈ s
SbtCosmo.Derivation.GroundParametricFixedPoint.invariant_ball.{u_2} {E : Type u_2} [NormedAddCommGroup E] {f : E → E}
  {u : E} {r : ℝ} {q : NNReal} (hr : 0 ≤ r) (hq : q < 1) (hl : LipschitzOnWith q f (Metric.closedBall u r))
  (he : dist (f u) u ≤ (1 - ↑q) * r) : Set.MapsTo f (Metric.closedBall u r) (Metric.closedBall u r)
SbtCosmo.Derivation.GroundParametricFixedPoint.ball_return.{u_2} {E : Type u_2} [NormedAddCommGroup E] [CompleteSpace E]
  {f : E → E} {u : E} {r : ℝ} {q : NNReal} (hr : 0 < r) (hq : q < 1) (hl : LipschitzOnWith q f (Metric.closedBall u r))
  (he : dist (f u) u ≤ (1 - ↑q) * (r / 4)) :
  ∃ v ∈ Metric.closedBall u (r / 4),
    f v = v ∧
      ∀ x ∈ Metric.closedBall u r,
        Filter.Tendsto (fun n => f^[n] x) Filter.atTop (nhds v) ∧ ∀ (n : ℕ), f^[n] x ∈ Metric.closedBall u r
