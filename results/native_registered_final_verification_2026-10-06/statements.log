SbtCosmo.Derivation.NativeOriginalSampleResults.original_sample_cyclic_return (i : Fin 12) (hi : 10 ≤ ↑i) :
  ∃ a c,
    SbtCosmo.Derivation.NativeOriginalSampleInterface.g i a = c ∧
      SbtCosmo.Derivation.NativeOriginalSampleInterface.g i c = a ∧
        c ≠ a ∧
          SbtCosmo.Derivation.GroundState.complexNormSq a = 1 ∧
            SbtCosmo.Derivation.GroundState.complexNormSq c = 1 ∧
              SbtCosmo.Derivation.NativeOriginalSampleResults.densityGap i <
                  Complex.normSq (c 4) - Complex.normSq (a 4) ∧
                Filter.Tendsto (fun n => SbtCosmo.Derivation.NativeOriginalSampleInterface.orbit i (2 * n)) Filter.atTop
                    (nhds a) ∧
                  Filter.Tendsto (fun n => SbtCosmo.Derivation.NativeOriginalSampleInterface.orbit i (2 * n + 1))
                      Filter.atTop (nhds c) ∧
                    (¬∃ l,
                          Filter.Tendsto (SbtCosmo.Derivation.NativeOriginalSampleInterface.orbit i) Filter.atTop
                            (nhds l)) ∧
                      ¬∃ l,
                          Filter.Tendsto
                            (fun n => Complex.normSq (SbtCosmo.Derivation.NativeOriginalSampleInterface.orbit i n 4))
                            Filter.atTop (nhds l)
