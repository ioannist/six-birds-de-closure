  (hLip : LipschitzOnWith M f^[j] (Metric.closedBall c R)) (hdefect : dist (f^[j] c) c ≤ d) (hbudget : ↑M * r + d ≤ R) :
  f^[j] a ∈ Metric.closedBall c R
