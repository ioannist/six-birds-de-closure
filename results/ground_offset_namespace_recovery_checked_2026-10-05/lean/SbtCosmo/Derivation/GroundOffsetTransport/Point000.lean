    ∀ n : ℕ, ActivePhase GroundNativeControls.originalTolerance b (κ 0 : ℝ) (orbit 0 b n) ∧
      NativeLegal GroundNativeControls.originalTolerance b (κ 0 : ℝ) (1/2) (orbit 0 b n) ∧
      complexNormSq (orbit 0 b n) = 1 :=
  whole_seed_return 0 certificate hb (entry hb)
end
