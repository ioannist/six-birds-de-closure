  have hd := endpoint_distance 3 certificate hb hc
  have hbudget : (certificate.radius (Fin.last N) : ℝ)+(γ : ℝ) ≤ (δ : ℝ) := by
    exact_mod_cast entry_arithmetic.2.1
  exact hd.trans hbudget

theorem entry {b : Field} (hb : ∀ j, (β 3 j).Contains (b j)) :
    (GroundOriginalOffsetBasins.T 3).symm (unpack (orbit 3 b N)) ∈ closedBall
      ((GroundOriginalOffsetBasins.T 3).symm (-(GroundOriginalOffsetStability.wholeRoot 3 hb).1,0))
