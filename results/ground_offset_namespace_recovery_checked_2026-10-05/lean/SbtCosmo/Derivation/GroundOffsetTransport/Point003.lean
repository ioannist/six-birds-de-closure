theorem distance {b : Field} (hb : ∀ j, (β 3 j).Contains (b j)) :
    dist ((GroundOriginalOffsetBasins.T 3).symm (unpack (orbit 3 b N)))
      ((GroundOriginalOffsetBasins.T 3).symm (-(GroundOriginalOffsetStability.wholeRoot 3 hb).1,0)) ≤ (δ : ℝ) := by
