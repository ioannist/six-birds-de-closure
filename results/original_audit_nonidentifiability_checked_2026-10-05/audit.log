 Quot.sound]
SbtCosmo.Derivation.GroundOriginalAuditNonidentifiability.finite_readout_eq_verdict (i : Fin 18) :
  SbtCosmo.Derivation.GroundOriginalAuditNonidentifiability.finiteReadout i =
    SbtCosmo.Derivation.GroundOriginalOffsetSixty.verdict i
'SbtCosmo.Derivation.GroundOriginalAuditNonidentifiability.finite_readout_eq_verdict' depends on axioms: [propext,
 Classical.choice,
 Quot.sound]
SbtCosmo.Derivation.GroundOriginalAuditNonidentifiability.actual_passing_split_pair :
  SbtCosmo.Derivation.GroundOriginalOffsetSixty.Tests 0 ∧
    SbtCosmo.Derivation.GroundOriginalOffsetSixty.Tests 3 ∧
      SbtCosmo.Derivation.GroundOriginalAuditNonidentifiability.finiteReadout 0 =
          SbtCosmo.Derivation.GroundOriginalAuditNonidentifiability.finiteReadout 3 ∧
        SbtCosmo.Derivation.GroundOriginalOffsets.offsets 0 ≠ SbtCosmo.Derivation.GroundOriginalOffsets.offsets 3
'SbtCosmo.Derivation.GroundOriginalAuditNonidentifiability.actual_passing_split_pair' depends on axioms: [propext,
 Classical.choice,
 Quot.sound]
SbtCosmo.Derivation.GroundOriginalAuditNonidentifiability.finite_admitted_offset_count :
  (Finset.image SbtCosmo.Derivation.GroundOriginalOffsets.offsets
        {i | SbtCosmo.Derivation.GroundOriginalAuditNonidentifiability.finiteReadout i = true}).card =
    15
'SbtCosmo.Derivation.GroundOriginalAuditNonidentifiability.finite_admitted_offset_count' depends on axioms: [propext,
 Classical.choice,
 Quot.sound]
SbtCosmo.Derivation.GroundOriginalAuditNonidentifiability.no_finite_readout_decoder :
