          SbtCosmo.Derivation.GroundOriginalOffsets.offsets i
'SbtCosmo.Derivation.GroundOriginalAuditNonidentifiability.no_finite_readout_decoder' depends on axioms: [propext,
 Classical.choice,
 Quot.sound]
