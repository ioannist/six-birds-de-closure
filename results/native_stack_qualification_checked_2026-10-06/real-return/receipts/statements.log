SbtCosmo.Derivation.NativeCycle20.RealOriginalReturn.real_even_odd_limits_of_entry (N : ℕ)
  (hentry :
    SbtCosmo.Derivation.NativeCycleFrame20.T.symm
        (SbtCosmo.Derivation.GroundNativePhase.unpack
          (SbtCosmo.Derivation.NativeCycle20.g^[2 * N] SbtCosmo.Derivation.GroundOriginalSeed.initial)) ∈
      Metric.closedBall (SbtCosmo.Derivation.NativeCycle20.centers 0) ↑SbtCosmo.Derivation.NativeCycle20.Step000.ρ) :
  ∃ a c,
    SbtCosmo.Derivation.NativeRealProfiles.IsReal a ∧
      SbtCosmo.Derivation.NativeRealProfiles.IsReal c ∧
        SbtCosmo.Derivation.NativeCycle20.g a = c ∧
          SbtCosmo.Derivation.NativeCycle20.g c = a ∧
            c ≠ a ∧
              SbtCosmo.Derivation.GroundState.complexNormSq a = 1 ∧
                SbtCosmo.Derivation.GroundState.complexNormSq c = 1 ∧
                  1 / 4 < Complex.normSq (c 4) - Complex.normSq (a 4) ∧
                    Filter.Tendsto
                        (fun n =>
                          SbtCosmo.Derivation.NativeCycle20.g^[2 * n] SbtCosmo.Derivation.GroundOriginalSeed.initial)
                        Filter.atTop (nhds a) ∧
                      Filter.Tendsto
                        (fun n =>
                          SbtCosmo.Derivation.NativeCycle20.g^[2 * n + 1]
                            SbtCosmo.Derivation.GroundOriginalSeed.initial)
                        Filter.atTop (nhds c)
