SbtCosmo.Derivation.NativeCycleSeed20.RealReturn.original_seed_cycle_real :
  ∃ z₀ z₁,
    SbtCosmo.Derivation.NativeRealProfiles.IsReal z₀ ∧
      SbtCosmo.Derivation.NativeRealProfiles.IsReal z₁ ∧
        SbtCosmo.Derivation.NativeCycleSeed20.g z₀ = z₁ ∧
          SbtCosmo.Derivation.NativeCycleSeed20.g z₁ = z₀ ∧
            SbtCosmo.Derivation.GroundState.complexNormSq z₀ = 1 ∧
              SbtCosmo.Derivation.GroundState.complexNormSq z₁ = 1 ∧
                1 / 4 < Complex.normSq (z₁ 4) - Complex.normSq (z₀ 4) ∧
                  Filter.Tendsto
                      (fun n =>
                        SbtCosmo.Derivation.NativeCycleSeed20.g^[2 * n] SbtCosmo.Derivation.GroundOriginalSeed.initial)
                      Filter.atTop (nhds z₀) ∧
                    Filter.Tendsto
                        (fun n =>
                          SbtCosmo.Derivation.NativeCycleSeed20.g^[2 * n + 1]
                            SbtCosmo.Derivation.GroundOriginalSeed.initial)
                        Filter.atTop (nhds z₁) ∧
                      (∀ (n : ℕ),
                          SbtCosmo.Derivation.GroundNativeIteration.ActivePhase
                              (↑SbtCosmo.Derivation.GroundNativePrefixInitial.τ)
                              (SbtCosmo.Derivation.GroundKernelTube.background
                                SbtCosmo.Derivation.GroundOriginalFirstTube.originalBackground)
                              (↑SbtCosmo.Derivation.NativeCycleFrame20.κ)
                              (SbtCosmo.Derivation.NativeCycleSeed20.g^[n]
                                SbtCosmo.Derivation.GroundOriginalSeed.initial) ∧
                            SbtCosmo.Derivation.GroundNativeIteration.NativeLegal
                                (↑SbtCosmo.Derivation.GroundNativePrefixInitial.τ)
                                (SbtCosmo.Derivation.GroundKernelTube.background
                                  SbtCosmo.Derivation.GroundOriginalFirstTube.originalBackground)
                                (↑SbtCosmo.Derivation.NativeCycleFrame20.κ) (1 / 2)
                                (SbtCosmo.Derivation.NativeCycleSeed20.g^[n]
                                  SbtCosmo.Derivation.GroundOriginalSeed.initial) ∧
                              SbtCosmo.Derivation.GroundState.complexNormSq
                                  (SbtCosmo.Derivation.NativeCycleSeed20.g^[n]
                                    SbtCosmo.Derivation.GroundOriginalSeed.initial) =
                                1) ∧
                        (¬∃ l,
                              Filter.Tendsto
                                (fun n =>
                                  SbtCosmo.Derivation.NativeCycleSeed20.g^[n]
                                    SbtCosmo.Derivation.GroundOriginalSeed.initial)
                                Filter.atTop (nhds l)) ∧
                          Filter.Tendsto
                              (fun n =>
                                Complex.normSq
                                  (SbtCosmo.Derivation.NativeCycleSeed20.g^[2 * n]
                                    SbtCosmo.Derivation.GroundOriginalSeed.initial 4))
                              Filter.atTop (nhds (Complex.normSq (z₀ 4))) ∧
                            Filter.Tendsto
                                (fun n =>
                                  Complex.normSq
                                    (SbtCosmo.Derivation.NativeCycleSeed20.g^[2 * n + 1]
                                      SbtCosmo.Derivation.GroundOriginalSeed.initial 4))
                                Filter.atTop (nhds (Complex.normSq (z₁ 4))) ∧
                              (∀ᶠ (n : ℕ) in Filter.atTop,
                                  1 / 4 <
                                    Complex.normSq
                                        (SbtCosmo.Derivation.NativeCycleSeed20.g^[2 * n + 1]
                                          SbtCosmo.Derivation.GroundOriginalSeed.initial 4) -
                                      Complex.normSq
                                        (SbtCosmo.Derivation.NativeCycleSeed20.g^[2 * n]
                                          SbtCosmo.Derivation.GroundOriginalSeed.initial 4)) ∧
                                ¬∃ l,
                                    Filter.Tendsto
                                      (fun n =>
                                        Complex.normSq
                                          (SbtCosmo.Derivation.NativeCycleSeed20.g^[n]
                                            SbtCosmo.Derivation.GroundOriginalSeed.initial 4))
                                      Filter.atTop (nhds l)
