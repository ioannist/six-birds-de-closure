SbtCosmo.Derivation.GroundOriginalCycle30CoordinateBasin.open_coordinate_basin :
  ∃ a,
    SbtCosmo.Derivation.NativeRealProfiles.IsReal (SbtCosmo.Derivation.GroundOriginalCycle30Baseline.source a) ∧
      ∃ δ > 0,
        ∃ r > 0,
          ∀ p ∈ Metric.closedBall SbtCosmo.Derivation.GroundOriginalCycle30Baseline.baseline δ,
            ∃ v ∈ Metric.closedBall a (r / 4),
              (SbtCosmo.Derivation.GroundOriginalCycle30Baseline.map p)^[2] v = v ∧
                (p, v) ∈ SbtCosmo.Derivation.GroundOriginalCycle30Baseline.pairGuard ∧
                  9 / 20 <
                      Complex.normSq
                          (SbtCosmo.Derivation.GroundOriginalCycle30Baseline.source
                            (SbtCosmo.Derivation.GroundOriginalCycle30Baseline.map p v) 4) -
                        Complex.normSq (SbtCosmo.Derivation.GroundOriginalCycle30Baseline.source v 4) ∧
                    Filter.Tendsto
                        (fun n =>
                          (SbtCosmo.Derivation.GroundOriginalCycle30Baseline.map p)^[2] ^[n]
