SbtCosmo.Derivation.GroundNativeBackgroundSeedReturn.nearby_native_seed_branch_return
  (T : SbtCosmo.Derivation.GroundNativePhase.State ≃L[ℝ] SbtCosmo.Derivation.GroundNativePhase.State)
  {b₀ u : SbtCosmo.Derivation.GroundState.Field} {κ m τ : ℝ} {z : SbtCosmo.Derivation.GroundState.ComplexField}
  {v : SbtCosmo.Derivation.GroundState.Field → SbtCosmo.Derivation.GroundState.Field} (hτ0 : 0 ≤ τ) (hτ1 : τ < 1)
  (hu : SbtCosmo.Derivation.GroundState.normSq u = 1)
  (hf : SbtCosmo.Derivation.GroundSourceJacobian.groundMap b₀ κ u = u)
  (hd : ‖SbtCosmo.Derivation.GroundNativeLocal.coordinateDerivative T b₀ κ m u‖ < 1) (hv : ContinuousAt v b₀)
  (hv0 : v b₀ = u)
  (hvg :
    ∀ᶠ (b : SbtCosmo.Derivation.GroundState.Field) in nhds b₀,
      SbtCosmo.Derivation.GroundState.normSq (v b) = 1 ∧
        SbtCosmo.Derivation.GroundSourceJacobian.groundMap b κ (v b) = v b)
  (hlim :
    Filter.Tendsto (fun n => (SbtCosmo.Derivation.GroundNativeIteration.nativeUpdate τ b₀ κ m)^[n] z) Filter.atTop
      (nhds (SbtCosmo.Derivation.GroundState.realEmbed (-u))))
  (hg :
    ∀ (n : ℕ),
      SbtCosmo.Derivation.GroundNativeIteration.ActivePhase τ b₀ κ
          ((SbtCosmo.Derivation.GroundNativeIteration.nativeUpdate τ b₀ κ m)^[n] z) ∧
        SbtCosmo.Derivation.GroundNativeIteration.NativeLegal τ b₀ κ m
          ((SbtCosmo.Derivation.GroundNativeIteration.nativeUpdate τ b₀ κ m)^[n] z))
  (hz : SbtCosmo.Derivation.GroundState.complexNormSq z = 1) :
  ∃ δ > 0,
    ∀ b ∈ Metric.closedBall b₀ δ,
      Filter.Tendsto (fun n => (SbtCosmo.Derivation.GroundNativeIteration.nativeUpdate τ b κ m)^[n] z) Filter.atTop
          (nhds (SbtCosmo.Derivation.GroundState.realEmbed (-v b))) ∧
        ∀ (n : ℕ),
          SbtCosmo.Derivation.GroundNativeIteration.ActivePhase τ b κ
              ((SbtCosmo.Derivation.GroundNativeIteration.nativeUpdate τ b κ m)^[n] z) ∧
            SbtCosmo.Derivation.GroundNativeIteration.NativeLegal τ b κ m
                ((SbtCosmo.Derivation.GroundNativeIteration.nativeUpdate τ b κ m)^[n] z) ∧
              SbtCosmo.Derivation.GroundState.complexNormSq
                  ((SbtCosmo.Derivation.GroundNativeIteration.nativeUpdate τ b κ m)^[n] z) =
                1
SbtCosmo.Derivation.GroundNativeBackgroundShift.source_uniform_shift (b : SbtCosmo.Derivation.GroundState.Field)
  (κ s : ℝ) (z : SbtCosmo.Derivation.GroundState.ComplexField) (i : Fin 8) :
  SbtCosmo.Derivation.GroundState.complexSourcePotential (fun j => b j + s) κ z i -
      SbtCosmo.Derivation.GroundState.complexSourcePotential b κ z i =
    s * (1 + κ * Complex.normSq (z i))
SbtCosmo.Derivation.GroundNativeBackgroundShift.source_shift_site_difference (b : SbtCosmo.Derivation.GroundState.Field)
  (κ s : ℝ) (z : SbtCosmo.Derivation.GroundState.ComplexField) (i j : Fin 8) :
  SbtCosmo.Derivation.GroundState.complexSourcePotential (fun k => b k + s) κ z i -
        SbtCosmo.Derivation.GroundState.complexSourcePotential b κ z i -
      (SbtCosmo.Derivation.GroundState.complexSourcePotential (fun k => b k + s) κ z j -
        SbtCosmo.Derivation.GroundState.complexSourcePotential b κ z j) =
    s * κ * (Complex.normSq (z i) - Complex.normSq (z j))
SbtCosmo.Derivation.GroundNativeBackgroundShift.source_shift_nonconstant (b : SbtCosmo.Derivation.GroundState.Field)
  {κ s : ℝ} (hκ : κ ≠ 0) (hs : s ≠ 0) (z : SbtCosmo.Derivation.GroundState.ComplexField) (i j : Fin 8)
  (hd : Complex.normSq (z i) ≠ Complex.normSq (z j)) :
  SbtCosmo.Derivation.GroundState.complexSourcePotential (fun k => b k + s) κ z i -
      SbtCosmo.Derivation.GroundState.complexSourcePotential b κ z i ≠
    SbtCosmo.Derivation.GroundState.complexSourcePotential (fun k => b k + s) κ z j -
      SbtCosmo.Derivation.GroundState.complexSourcePotential b κ z j
