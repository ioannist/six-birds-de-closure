SbtCosmo.Derivation.GroundOriginalCycle30FiniteAttractorLanding.open_finite_and_real_cycle :
  ∃ δ > 0,
    ∀ p ∈ Metric.closedBall SbtCosmo.Derivation.GroundOriginalCycle30FiniteVerdicts.baseline δ,
      ∃ z₀ z₁,
        SbtCosmo.Derivation.NativeRealProfiles.IsReal z₀ ∧
          SbtCosmo.Derivation.NativeRealProfiles.IsReal z₁ ∧
            SbtCosmo.Derivation.GroundOriginalCycle30FiniteVerdicts.native p z₀ = z₁ ∧
              SbtCosmo.Derivation.GroundOriginalCycle30FiniteVerdicts.native p z₁ = z₀ ∧
                SbtCosmo.Derivation.GroundState.complexNormSq z₀ = 1 ∧
                  SbtCosmo.Derivation.GroundState.complexNormSq z₁ = 1 ∧
                    9 / 20 < Complex.normSq (z₁ 4) - Complex.normSq (z₀ 4) ∧
                      Filter.Tendsto (fun n => SbtCosmo.Derivation.GroundOriginalCycle30FiniteVerdicts.orbit p (2 * n))
                          Filter.atTop (nhds z₀) ∧
                        Filter.Tendsto
                            (fun n => SbtCosmo.Derivation.GroundOriginalCycle30FiniteVerdicts.orbit p (2 * n + 1))
                            Filter.atTop (nhds z₁) ∧
                          (∀ (n : ℕ),
                              SbtCosmo.Derivation.GroundNativeIteration.ActivePhase
                                  SbtCosmo.Derivation.GroundNativeControls.originalTolerance p.1 p.2
                                  (SbtCosmo.Derivation.GroundOriginalCycle30FiniteVerdicts.orbit p n) ∧
                                SbtCosmo.Derivation.GroundNativeIteration.NativeLegal
                                    SbtCosmo.Derivation.GroundNativeControls.originalTolerance p.1 p.2 (1 / 2)
                                    (SbtCosmo.Derivation.GroundOriginalCycle30FiniteVerdicts.orbit p n) ∧
                                  SbtCosmo.Derivation.GroundState.complexNormSq
                                      (SbtCosmo.Derivation.GroundOriginalCycle30FiniteVerdicts.orbit p n) =
                                    1) ∧
                            (¬∃ l,
                                  Filter.Tendsto
                                    (fun n => SbtCosmo.Derivation.GroundOriginalCycle30FiniteVerdicts.orbit p n)
                                    Filter.atTop (nhds l)) ∧
                              (¬∃ l,
                                    Filter.Tendsto
                                      (fun n =>
                                        Complex.normSq
                                          (SbtCosmo.Derivation.GroundOriginalCycle30FiniteVerdicts.orbit p n 4))
                                      Filter.atTop (nhds l)) ∧
                                (∀ n < 60,
                                    ¬SbtCosmo.Derivation.GroundSourceDiagnostics.MeetsConvergence
                                        SbtCosmo.Derivation.GroundNativeControls.originalTolerance
                                        SbtCosmo.Derivation.GroundOriginalResiduals.ε p.1 p.2 (1 / 2)
                                        (SbtCosmo.Derivation.GroundOriginalCycle30FiniteVerdicts.orbit p n)
                                        (SbtCosmo.Derivation.GroundOriginalCycle30FiniteVerdicts.orbit p (n + 1))) ∧
                                  ∃ s ∈ nhds z₀,
                                    ∀ z ∈ s,
                                      Filter.Tendsto
                                          (fun n =>
                                            (SbtCosmo.Derivation.GroundOriginalCycle30FiniteVerdicts.native p)^[2 * n]
                                              z)
                                          Filter.atTop (nhds z₀) ∧
                                        Filter.Tendsto
                                            (fun n =>
                                              (SbtCosmo.Derivation.GroundOriginalCycle30FiniteVerdicts.native
                                                    p)^[2 * n + 1]
                                                z)
                                            Filter.atTop (nhds z₁) ∧
                                          (∀ (n : ℕ),
                                              SbtCosmo.Derivation.GroundNativeIteration.ActivePhase
                                                  SbtCosmo.Derivation.GroundNativeControls.originalTolerance p.1 p.2
                                                  ((SbtCosmo.Derivation.GroundOriginalCycle30FiniteVerdicts.native
                                                        p)^[n]
                                                    z) ∧
                                                SbtCosmo.Derivation.GroundNativeIteration.NativeLegal
                                                  SbtCosmo.Derivation.GroundNativeControls.originalTolerance p.1 p.2
                                                  (1 / 2)
                                                  ((SbtCosmo.Derivation.GroundOriginalCycle30FiniteVerdicts.native
                                                        p)^[n]
                                                    z)) ∧
                                            ∀ (n : ℕ),
                                              SbtCosmo.Derivation.GroundState.complexNormSq
                                                  ((SbtCosmo.Derivation.GroundOriginalCycle30FiniteVerdicts.native
                                                        p)^[n + 1]
                                                    z) =
                                                1
