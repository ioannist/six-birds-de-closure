                        Filter.atTop (nhds v) ∧
                      (∀ (n : ℕ),
                          (p,
                              (SbtCosmo.Derivation.GroundOriginalCycle30Baseline.map p)^[n]
                                SbtCosmo.Derivation.GroundOriginalCycle30Baseline.seed) ∈
                            SbtCosmo.Derivation.GroundOriginalCycle30Baseline.guard) ∧
                        ∀ x ∈ Metric.closedBall a r,
                          Filter.Tendsto (fun n => (SbtCosmo.Derivation.GroundOriginalCycle30Baseline.map p)^[2] ^[n] x)
                              Filter.atTop (nhds v) ∧
                            ∀ (n : ℕ),
