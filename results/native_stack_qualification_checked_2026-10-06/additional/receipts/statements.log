  {p : SbtCosmo.Derivation.GroundOriginalCycle30Baseline.Parameter}
  {z₀ z₁ z : SbtCosmo.Derivation.GroundState.ComplexField}
  (hg : SbtCosmo.Derivation.GroundOriginalCycle30TwoPhaseBasin.Guard p z)
  (h :
    SbtCosmo.Derivation.GroundOriginalCycle30TwoPhaseBasin.Landing p z₀ z₁
