SbtCosmo.Derivation.GroundOriginalOpenBackgroundReadout.open_background_density_limits (i : Fin 18) :
  ∃ δ > 0,
    ∀ b ∈ Metric.closedBall (SbtCosmo.Derivation.GroundOriginalOffsets.rounded_b i) δ,
      ∀ (j : Fin 8),
        Filter.Tendsto (fun n => Complex.normSq (SbtCosmo.Derivation.GroundOriginalOpenBackgroundReadout.orbit i b n j))
          Filter.atTop (nhds (SbtCosmo.Derivation.GroundOriginalOpenBackgroundReadout.density i b j))
SbtCosmo.Derivation.GroundOriginalOpenBackgroundReadout.open_endpoint_density_separation :
  ∃ δ > 0,
    ∀ b₀ ∈ Metric.closedBall (SbtCosmo.Derivation.GroundOriginalOffsets.rounded_b 0) δ,
      ∀ b₁ ∈ Metric.closedBall (SbtCosmo.Derivation.GroundOriginalOffsets.rounded_b 17) δ,
        ∀ᶠ (n : ℕ) in Filter.atTop,
          Complex.normSq (SbtCosmo.Derivation.GroundOriginalOpenBackgroundReadout.orbit 0 b₀ n 0) + 9 / 100 <
            Complex.normSq (SbtCosmo.Derivation.GroundOriginalOpenBackgroundReadout.orbit 17 b₁ n 0)
SbtCosmo.Derivation.GroundParametricBranchReturn.nearby_original_seed_branch_returns.{u_1, u_2} {P : Type u_1}
  {E : Type u_2} [NormedAddCommGroup P] [NormedSpace ℝ P] [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E]
  {f : P → E → E} {p : P} {u a : E} {s : Set (P × E)} {g : P → E} (hc : ContDiffAt ℝ 1 (Function.uncurry f) (p, u))
  (hf : f p u = u) (hd : ‖fderiv ℝ (f p) u‖ < 1) (hs : s ∈ nhds (p, u))
  (horbit : ∀ (n : ℕ), ContinuousAt (Function.uncurry f) (p, (f p)^[n] a))
  (hguards : ∀ (n : ℕ), s ∈ nhds (p, (f p)^[n] a)) (hlim : Filter.Tendsto (fun n => (f p)^[n] a) Filter.atTop (nhds u))
  (hg : ContinuousAt g p) (hg0 : g p = u) (hgfix : ∀ᶠ (b : P) in nhds p, f b (g b) = g b) :
  ∃ δ > 0,
    ∀ b ∈ Metric.closedBall p δ,
      Filter.Tendsto (fun n => (f b)^[n] a) Filter.atTop (nhds (g b)) ∧ ∀ (n : ℕ), (b, (f b)^[n] a) ∈ s
