SbtCosmo.Derivation.GroundOriginalCycle20FiniteVerdicts.open_first_sixty_fail :
  ∃ δ > 0,
    ∀ p ∈ Metric.closedBall SbtCosmo.Derivation.GroundOriginalCycle20FiniteVerdicts.baseline δ,
      (∀ n < 60,
          SbtCosmo.Derivation.GroundNativeIteration.ActivePhase
              SbtCosmo.Derivation.GroundNativeControls.originalTolerance p.1 p.2
              (SbtCosmo.Derivation.GroundOriginalCycle20FiniteVerdicts.orbit p n) ∧
            SbtCosmo.Derivation.GroundNativeIteration.NativeLegal
                SbtCosmo.Derivation.GroundNativeControls.originalTolerance p.1 p.2 (1 / 2)
                (SbtCosmo.Derivation.GroundOriginalCycle20FiniteVerdicts.orbit p n) ∧
              SbtCosmo.Derivation.GroundOriginalResiduals.ε <
                  SbtCosmo.Derivation.GroundOriginalCycle20FiniteVerdicts.stepLength p n ∧
                ¬SbtCosmo.Derivation.GroundSourceDiagnostics.MeetsConvergence
                    SbtCosmo.Derivation.GroundNativeControls.originalTolerance
                    SbtCosmo.Derivation.GroundOriginalResiduals.ε p.1 p.2 (1 / 2)
                    (SbtCosmo.Derivation.GroundOriginalCycle20FiniteVerdicts.orbit p n)
                    (SbtCosmo.Derivation.GroundOriginalCycle20FiniteVerdicts.orbit p (n + 1))) ∧
        ∀ n ≤ 60,
          SbtCosmo.Derivation.GroundState.complexNormSq
              (SbtCosmo.Derivation.GroundOriginalCycle20FiniteVerdicts.orbit p n) =
            1
