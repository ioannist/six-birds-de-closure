SbtCosmo.Derivation.GroundParametricContraction.uniform_local_lipschitz.{u_1, u_2} {P : Type u_1} {E : Type u_2}
  [NormedAddCommGroup P] [NormedSpace ℝ P] [NormedAddCommGroup E] [NormedSpace ℝ E] {f : P → E → E} {p : P} {u : E}
  {s : Set (P × E)} (hc : ContDiffAt ℝ 1 (Function.uncurry f) (p, u)) (hd : ‖fderiv ℝ (f p) u‖ < 1)
  (hs : s ∈ nhds (p, u)) :
  ∃ δ > 0,
    ∃ r > 0,
      ∃ q < 1,
        ∀ b ∈ Metric.closedBall p δ,
          LipschitzOnWith q (f b) (Metric.closedBall u r) ∧ ∀ x ∈ Metric.closedBall u r, (b, x) ∈ s
