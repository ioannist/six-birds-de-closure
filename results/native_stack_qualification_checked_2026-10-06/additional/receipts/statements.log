SbtCosmo.Derivation.GroundOriginalCycle30TwoPhaseBasin.opposite_phase_neighborhood
  {p : SbtCosmo.Derivation.GroundOriginalCycle30Baseline.Parameter}
  {z₀ z₁ : SbtCosmo.Derivation.GroundState.ComplexField}
  (h01 : SbtCosmo.Derivation.GroundOriginalCycle30OpenReturn.native p z₀ = z₁)
  (h10 : SbtCosmo.Derivation.GroundOriginalCycle30OpenReturn.native p z₁ = z₀)
  {s₀ : Set SbtCosmo.Derivation.GroundState.ComplexField} (hs₀ : s₀ ∈ nhds z₀)
  (hlocal : ∀ z ∈ s₀, SbtCosmo.Derivation.GroundOriginalCycle30TwoPhaseBasin.Landing p z₀ z₁ z) :
  ∃ s₁ ∈ nhds z₁, ∀ z ∈ s₁, SbtCosmo.Derivation.GroundOriginalCycle30TwoPhaseBasin.Landing p z₁ z₀ z
SbtCosmo.Derivation.GroundOriginalCycle30TwoPhaseBasin.open_both_phases_attracting_cycle :
  ∃ δ > 0,
    ∀ p ∈ Metric.closedBall SbtCosmo.Derivation.GroundOriginalCycle30Baseline.baseline δ,
      ∃ z₀ z₁,
        SbtCosmo.Derivation.NativeRealProfiles.IsReal z₀ ∧
          SbtCosmo.Derivation.NativeRealProfiles.IsReal z₁ ∧
            SbtCosmo.Derivation.GroundOriginalCycle30OpenReturn.native p z₀ = z₁ ∧
              SbtCosmo.Derivation.GroundOriginalCycle30OpenReturn.native p z₁ = z₀ ∧
                SbtCosmo.Derivation.GroundState.complexNormSq z₀ = 1 ∧
                  SbtCosmo.Derivation.GroundState.complexNormSq z₁ = 1 ∧
                    9 / 20 < Complex.normSq (z₁ 4) - Complex.normSq (z₀ 4) ∧
                      SbtCosmo.Derivation.GroundOriginalCycle30TwoPhaseBasin.Landing p z₀ z₁
                          SbtCosmo.Derivation.GroundOriginalSeed.initial ∧
                        (∀ (n : ℕ),
                            SbtCosmo.Derivation.GroundState.complexNormSq
                                ((SbtCosmo.Derivation.GroundOriginalCycle30OpenReturn.native p)^[n]
                                  SbtCosmo.Derivation.GroundOriginalSeed.initial) =
                              1) ∧
                          ∃ s₀ s₁,
                            s₀ ∈ nhds z₀ ∧
                              s₁ ∈ nhds z₁ ∧
                                (∀ z ∈ s₀, SbtCosmo.Derivation.GroundOriginalCycle30TwoPhaseBasin.Landing p z₀ z₁ z) ∧
                                  ∀ z ∈ s₁, SbtCosmo.Derivation.GroundOriginalCycle30TwoPhaseBasin.Landing p z₁ z₀ z
SbtCosmo.Derivation.GroundOriginalOpenBackground.rounded_newton_defect (i : Fin 18) :
  ‖SbtCosmo.Derivation.GroundRootCertificate.correctionDerivative
        (SbtCosmo.Derivation.GroundOriginalOffsets.rounded_b i)
        (↑(SbtCosmo.Derivation.GroundOriginalOffsets.certificates i).κ)
        (SbtCosmo.Derivation.GroundResidualEnclosure.preconditioner
          (SbtCosmo.Derivation.GroundOriginalOffsets.certificates i).C)
        (SbtCosmo.Derivation.GroundOriginalOffsets.roundedRoot i)‖ <
    1
SbtCosmo.Derivation.GroundOriginalOpenBackground.localPoint_center (i : Fin 18) :
  SbtCosmo.Derivation.GroundOriginalOpenBackground.localPoint i
      (SbtCosmo.Derivation.GroundOriginalOffsets.rounded_b i) =
    SbtCosmo.Derivation.GroundOriginalOffsets.roundedRoot i
SbtCosmo.Derivation.GroundOriginalOpenBackground.localPoint_smooth_at (i : Fin 18) :
  ContDiffAt ℝ (↑⊤) (SbtCosmo.Derivation.GroundOriginalOpenBackground.localPoint i)
    (SbtCosmo.Derivation.GroundOriginalOffsets.rounded_b i)
SbtCosmo.Derivation.GroundOriginalOpenBackground.localPoint_ground_eventually (i : Fin 18) :
  ∀ᶠ (b : SbtCosmo.Derivation.GroundState.Field) in nhds (SbtCosmo.Derivation.GroundOriginalOffsets.rounded_b i),
    SbtCosmo.Derivation.GroundRootCertificate.residual b (↑(SbtCosmo.Derivation.GroundOriginalOffsets.certificates i).κ)
          (SbtCosmo.Derivation.GroundOriginalOpenBackground.localPoint i b) =
        0 ∧
      (∀ (j : Fin 8), 0 < (SbtCosmo.Derivation.GroundOriginalOpenBackground.localPoint i b).1 j) ∧
        SbtCosmo.Derivation.GroundState.normSq (SbtCosmo.Derivation.GroundOriginalOpenBackground.localPoint i b).1 = 1 ∧
          SbtCosmo.Derivation.GroundBorder.groundPair
                (SbtCosmo.Derivation.GroundState.sourcePotential b
                  (↑(SbtCosmo.Derivation.GroundOriginalOffsets.certificates i).κ)
                  (SbtCosmo.Derivation.GroundOriginalOpenBackground.localPoint i b).1) =
              SbtCosmo.Derivation.GroundOriginalOpenBackground.localPoint i b ∧
            SbtCosmo.Derivation.GroundSourceJacobian.groundMap b
                (↑(SbtCosmo.Derivation.GroundOriginalOffsets.certificates i).κ)
                (SbtCosmo.Derivation.GroundOriginalOpenBackground.localPoint i b).1 =
              (SbtCosmo.Derivation.GroundOriginalOpenBackground.localPoint i b).1
SbtCosmo.Derivation.GroundOriginalOpenBackground.rounded_coordinate_contraction (i : Fin 18) :
  ‖SbtCosmo.Derivation.GroundNativeLocal.coordinateDerivative
        (SbtCosmo.Derivation.GroundOriginalOffsetStability.fullBasis i)
        (SbtCosmo.Derivation.GroundOriginalOffsets.rounded_b i)
        (↑(SbtCosmo.Derivation.GroundOriginalOffsets.certificates i).κ) (1 / 2)
        (SbtCosmo.Derivation.GroundOriginalOffsets.roundedRoot i).1‖ <
    1
SbtCosmo.Derivation.GroundOriginalOpenBackground.open_background_original_seed_return (i : Fin 18) :
  ∃ δ > 0,
    ∀ b ∈ Metric.closedBall (SbtCosmo.Derivation.GroundOriginalOffsets.rounded_b i) δ,
      SbtCosmo.Derivation.GroundRootCertificate.residual b
            (↑(SbtCosmo.Derivation.GroundOriginalOffsets.certificates i).κ)
            (SbtCosmo.Derivation.GroundOriginalOpenBackground.localPoint i b) =
          0 ∧
        (∀ (j : Fin 8), 0 < (SbtCosmo.Derivation.GroundOriginalOpenBackground.localPoint i b).1 j) ∧
          SbtCosmo.Derivation.GroundState.normSq (SbtCosmo.Derivation.GroundOriginalOpenBackground.localPoint i b).1 =
              1 ∧
            SbtCosmo.Derivation.GroundBorder.groundPair
                  (SbtCosmo.Derivation.GroundState.sourcePotential b
                    (↑(SbtCosmo.Derivation.GroundOriginalOffsets.certificates i).κ)
                    (SbtCosmo.Derivation.GroundOriginalOpenBackground.localPoint i b).1) =
                SbtCosmo.Derivation.GroundOriginalOpenBackground.localPoint i b ∧
              SbtCosmo.Derivation.GroundSourceJacobian.groundMap b
                    (↑(SbtCosmo.Derivation.GroundOriginalOffsets.certificates i).κ)
                    (SbtCosmo.Derivation.GroundOriginalOpenBackground.localPoint i b).1 =
                  (SbtCosmo.Derivation.GroundOriginalOpenBackground.localPoint i b).1 ∧
                Filter.Tendsto
                    (fun n =>
                      (SbtCosmo.Derivation.GroundNativeIteration.nativeUpdate
                            SbtCosmo.Derivation.GroundNativeControls.originalTolerance b
                            (↑(SbtCosmo.Derivation.GroundOriginalOffsets.certificates i).κ) (1 / 2))^[n]
                        SbtCosmo.Derivation.GroundOriginalSeed.initial)
                    Filter.atTop
                    (nhds
                      (SbtCosmo.Derivation.GroundState.realEmbed
                        (-(SbtCosmo.Derivation.GroundOriginalOpenBackground.localPoint i b).1))) ∧
                  ∀ (n : ℕ),
                    SbtCosmo.Derivation.GroundNativeIteration.ActivePhase
                        SbtCosmo.Derivation.GroundNativeControls.originalTolerance b
                        (↑(SbtCosmo.Derivation.GroundOriginalOffsets.certificates i).κ)
                        ((SbtCosmo.Derivation.GroundNativeIteration.nativeUpdate
                              SbtCosmo.Derivation.GroundNativeControls.originalTolerance b
                              (↑(SbtCosmo.Derivation.GroundOriginalOffsets.certificates i).κ) (1 / 2))^[n]
                          SbtCosmo.Derivation.GroundOriginalSeed.initial) ∧
                      SbtCosmo.Derivation.GroundNativeIteration.NativeLegal
                          SbtCosmo.Derivation.GroundNativeControls.originalTolerance b
                          (↑(SbtCosmo.Derivation.GroundOriginalOffsets.certificates i).κ) (1 / 2)
                          ((SbtCosmo.Derivation.GroundNativeIteration.nativeUpdate
                                SbtCosmo.Derivation.GroundNativeControls.originalTolerance b
                                (↑(SbtCosmo.Derivation.GroundOriginalOffsets.certificates i).κ) (1 / 2))^[n]
                            SbtCosmo.Derivation.GroundOriginalSeed.initial) ∧
                        SbtCosmo.Derivation.GroundState.complexNormSq
                            ((SbtCosmo.Derivation.GroundNativeIteration.nativeUpdate
                                  SbtCosmo.Derivation.GroundNativeControls.originalTolerance b
                                  (↑(SbtCosmo.Derivation.GroundOriginalOffsets.certificates i).κ) (1 / 2))^[n]
                              SbtCosmo.Derivation.GroundOriginalSeed.initial) =
                          1
