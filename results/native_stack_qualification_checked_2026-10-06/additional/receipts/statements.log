  {u : E} {r : ℝ} {q : NNReal} (hr : 0 ≤ r) (hq : q < 1) (hl : LipschitzOnWith q f (Metric.closedBall u r))
  (he : dist (f u) u ≤ (1 - ↑q) * r) : Set.MapsTo f (Metric.closedBall u r) (Metric.closedBall u r)
SbtCosmo.Derivation.GroundParametricFixedPoint.ball_return.{u_2} {E : Type u_2} [NormedAddCommGroup E] [CompleteSpace E]
  {f : E → E} {u : E} {r : ℝ} {q : NNReal} (hr : 0 < r) (hq : q < 1) (hl : LipschitzOnWith q f (Metric.closedBall u r))
  (he : dist (f u) u ≤ (1 - ↑q) * (r / 4)) :
  ∃ v ∈ Metric.closedBall u (r / 4),
    f v = v ∧
      ∀ x ∈ Metric.closedBall u r,
        Filter.Tendsto (fun n => f^[n] x) Filter.atTop (nhds v) ∧ ∀ (n : ℕ), f^[n] x ∈ Metric.closedBall u r
