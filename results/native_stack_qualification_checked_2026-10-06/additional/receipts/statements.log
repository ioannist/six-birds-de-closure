  (hr : 0 < r) (hz : SbtCosmo.Derivation.GroundOriginalCycle30BasinBridge.decode z ∈ Metric.closedBall a (r / 4)) :
  {w | SbtCosmo.Derivation.GroundOriginalCycle30BasinBridge.decode w ∈ Metric.closedBall a r} ∈ nhds z
SbtCosmo.Derivation.GroundOriginalCycle30AttractorLanding.open_real_attracting_cycle :
  ∃ δ > 0,
    ∀ p ∈ Metric.closedBall SbtCosmo.Derivation.GroundOriginalCycle30Baseline.baseline δ,
      ∃ z₀ z₁,
        SbtCosmo.Derivation.NativeRealProfiles.IsReal z₀ ∧
          SbtCosmo.Derivation.NativeRealProfiles.IsReal z₁ ∧
            SbtCosmo.Derivation.GroundOriginalCycle30OpenReturn.native p z₀ = z₁ ∧
              SbtCosmo.Derivation.GroundOriginalCycle30OpenReturn.native p z₁ = z₀ ∧
                SbtCosmo.Derivation.GroundState.complexNormSq z₀ = 1 ∧
                  SbtCosmo.Derivation.GroundState.complexNormSq z₁ = 1 ∧
                    9 / 20 < Complex.normSq (z₁ 4) - Complex.normSq (z₀ 4) ∧
                      Filter.Tendsto
                          (fun n =>
                            (SbtCosmo.Derivation.GroundOriginalCycle30OpenReturn.native p)^[2 * n]
                              SbtCosmo.Derivation.GroundOriginalSeed.initial)
                          Filter.atTop (nhds z₀) ∧
                        Filter.Tendsto
                            (fun n =>
                              (SbtCosmo.Derivation.GroundOriginalCycle30OpenReturn.native p)^[2 * n + 1]
                                SbtCosmo.Derivation.GroundOriginalSeed.initial)
                            Filter.atTop (nhds z₁) ∧
                          (∀ (n : ℕ),
                              SbtCosmo.Derivation.GroundNativeIteration.ActivePhase
                                  (↑SbtCosmo.Derivation.GroundNativePrefixInitial.τ) p.1 p.2
                                  ((SbtCosmo.Derivation.GroundOriginalCycle30OpenReturn.native p)^[n]
                                    SbtCosmo.Derivation.GroundOriginalSeed.initial) ∧
                                SbtCosmo.Derivation.GroundNativeIteration.NativeLegal
                                    (↑SbtCosmo.Derivation.GroundNativePrefixInitial.τ) p.1 p.2 (1 / 2)
                                    ((SbtCosmo.Derivation.GroundOriginalCycle30OpenReturn.native p)^[n]
                                      SbtCosmo.Derivation.GroundOriginalSeed.initial) ∧
                                  SbtCosmo.Derivation.GroundState.complexNormSq
                                      ((SbtCosmo.Derivation.GroundOriginalCycle30OpenReturn.native p)^[n]
                                        SbtCosmo.Derivation.GroundOriginalSeed.initial) =
                                    1) ∧
                            ∃ s ∈ nhds z₀,
                              ∀ z ∈ s,
                                Filter.Tendsto
                                    (fun n => (SbtCosmo.Derivation.GroundOriginalCycle30OpenReturn.native p)^[2 * n] z)
                                    Filter.atTop (nhds z₀) ∧
                                  Filter.Tendsto
                                      (fun n =>
                                        (SbtCosmo.Derivation.GroundOriginalCycle30OpenReturn.native p)^[2 * n + 1] z)
                                      Filter.atTop (nhds z₁) ∧
                                    (∀ (n : ℕ),
                                        SbtCosmo.Derivation.GroundNativeIteration.ActivePhase
                                            (↑SbtCosmo.Derivation.GroundNativePrefixInitial.τ) p.1 p.2
                                            ((SbtCosmo.Derivation.GroundOriginalCycle30OpenReturn.native p)^[n] z) ∧
                                          SbtCosmo.Derivation.GroundNativeIteration.NativeLegal
                                            (↑SbtCosmo.Derivation.GroundNativePrefixInitial.τ) p.1 p.2 (1 / 2)
                                            ((SbtCosmo.Derivation.GroundOriginalCycle30OpenReturn.native p)^[n] z)) ∧
                                      ∀ (n : ℕ),
                                        SbtCosmo.Derivation.GroundState.complexNormSq
                                            ((SbtCosmo.Derivation.GroundOriginalCycle30OpenReturn.native p)^[n + 1] z) =
                                          1
SbtCosmo.Derivation.GroundOriginalCycle30AttractorLanding.nearby_original_limits_real :
  ∃ δ > 0,
    ∀ p ∈ Metric.closedBall SbtCosmo.Derivation.GroundOriginalCycle30Baseline.baseline δ,
      ∀ (z₀ z₁ : SbtCosmo.Derivation.GroundState.ComplexField),
        Filter.Tendsto
            (fun n =>
              (SbtCosmo.Derivation.GroundOriginalCycle30OpenReturn.native p)^[2 * n]
                SbtCosmo.Derivation.GroundOriginalSeed.initial)
            Filter.atTop (nhds z₀) →
          Filter.Tendsto
              (fun n =>
                (SbtCosmo.Derivation.GroundOriginalCycle30OpenReturn.native p)^[2 * n + 1]
                  SbtCosmo.Derivation.GroundOriginalSeed.initial)
              Filter.atTop (nhds z₁) →
            SbtCosmo.Derivation.NativeRealProfiles.IsReal z₀ ∧ SbtCosmo.Derivation.NativeRealProfiles.IsReal z₁
SbtCosmo.Derivation.GroundOriginalCycle30AttractorLanding.open_real_original_seed_readouts :
  ∃ δ > 0,
    ∀ p ∈ Metric.closedBall SbtCosmo.Derivation.GroundOriginalCycle30Baseline.baseline δ,
      (¬∃ l,
            Filter.Tendsto
              (fun n =>
                (SbtCosmo.Derivation.GroundOriginalCycle30OpenReturn.native p)^[n]
                  SbtCosmo.Derivation.GroundOriginalSeed.initial)
              Filter.atTop (nhds l)) ∧
        (¬∃ l,
              Filter.Tendsto
                (fun n =>
                  Complex.normSq
                    ((SbtCosmo.Derivation.GroundOriginalCycle30OpenReturn.native p)^[n]
                      SbtCosmo.Derivation.GroundOriginalSeed.initial 4))
                Filter.atTop (nhds l)) ∧
          (∀ᶠ (n : ℕ) in Filter.atTop,
              9 / 20 <
                Complex.normSq
                    ((SbtCosmo.Derivation.GroundOriginalCycle30OpenReturn.native p)^[2 * n + 1]
                      SbtCosmo.Derivation.GroundOriginalSeed.initial 4) -
                  Complex.normSq
                    ((SbtCosmo.Derivation.GroundOriginalCycle30OpenReturn.native p)^[2 * n]
                      SbtCosmo.Derivation.GroundOriginalSeed.initial 4)) ∧
            (∀ᶠ (n : ℕ) in Filter.atTop,
                9 / 40 <
                  SbtCosmo.Derivation.GroundComplexEuclidean.l2
                    ((SbtCosmo.Derivation.GroundOriginalCycle30OpenReturn.native p)^[n + 1]
                        SbtCosmo.Derivation.GroundOriginalSeed.initial -
                      (SbtCosmo.Derivation.GroundOriginalCycle30OpenReturn.native p)^[n]
                        SbtCosmo.Derivation.GroundOriginalSeed.initial)) ∧
              ∀ᶠ (n : ℕ) in Filter.atTop,
                ¬SbtCosmo.Derivation.GroundSourceDiagnostics.MeetsConvergence
                    SbtCosmo.Derivation.GroundNativeControls.originalTolerance
                    SbtCosmo.Derivation.GroundOriginalResiduals.ε p.1 p.2 (1 / 2)
                    ((SbtCosmo.Derivation.GroundOriginalCycle30OpenReturn.native p)^[n]
                      SbtCosmo.Derivation.GroundOriginalSeed.initial)
                    ((SbtCosmo.Derivation.GroundOriginalCycle30OpenReturn.native p)^[n + 1]
                      SbtCosmo.Derivation.GroundOriginalSeed.initial)
