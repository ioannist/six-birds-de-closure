  (SbtCosmo.Derivation.GroundOriginalCycle30Baseline.baseline,
      (SbtCosmo.Derivation.GroundOriginalCycle30Baseline.map
            SbtCosmo.Derivation.GroundOriginalCycle30Baseline.baseline)^[n]
        SbtCosmo.Derivation.GroundOriginalCycle30Baseline.seed) ∈
    SbtCosmo.Derivation.GroundOriginalCycle30Baseline.guard
SbtCosmo.Derivation.GroundOriginalCycle30Baseline.strict_interior_budget :
  SbtCosmo.Derivation.NativeCycle30.selfDefect / (1 - SbtCosmo.Derivation.NativeCycle30.pairRate) <
    SbtCosmo.Derivation.NativeCycle30.Step000.ρ
SbtCosmo.Derivation.GroundOriginalCycle30Baseline.actual_baseline :
  ∃ a,
    (SbtCosmo.Derivation.GroundOriginalCycle30Baseline.map
              SbtCosmo.Derivation.GroundOriginalCycle30Baseline.baseline)^[2]
          a =
        a ∧
      ‖fderiv ℝ
              (SbtCosmo.Derivation.GroundOriginalCycle30Baseline.map
                  SbtCosmo.Derivation.GroundOriginalCycle30Baseline.baseline)^[2]
              a‖ <
          1 ∧
        (SbtCosmo.Derivation.GroundOriginalCycle30Baseline.baseline, a) ∈
            SbtCosmo.Derivation.GroundOriginalCycle30Baseline.pairGuard ∧
          9 / 20 <
              Complex.normSq
                  (SbtCosmo.Derivation.GroundOriginalCycle30Baseline.source
                    (SbtCosmo.Derivation.GroundOriginalCycle30Baseline.map
                      SbtCosmo.Derivation.GroundOriginalCycle30Baseline.baseline a)
                    4) -
                Complex.normSq (SbtCosmo.Derivation.GroundOriginalCycle30Baseline.source a 4) ∧
            Filter.Tendsto
              (fun n =>
                (SbtCosmo.Derivation.GroundOriginalCycle30Baseline.map
                        SbtCosmo.Derivation.GroundOriginalCycle30Baseline.baseline)^[2]
                      ^[n]
                  SbtCosmo.Derivation.GroundOriginalCycle30Baseline.seed)
