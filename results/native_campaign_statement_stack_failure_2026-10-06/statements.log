NativeApproximateCenterBanach.approximate_center_return.{u_1} {α : Type u_1} [MetricSpace α] [CompleteSpace α]
  (f : α → α) {c : α} {R d : ℝ} {q : NNReal} (hR : 0 ≤ R) (hq : q < 1)
  (hL : LipschitzOnWith q f (Metric.closedBall c R)) (hd : dist (f c) c ≤ d) (hbudget : ↑q * R + d ≤ R) :
  ∃ a ∈ Metric.closedBall c R,
    f a = a ∧
      dist a c ≤ d / (1 - ↑q) ∧
        (∀ x ∈ Metric.closedBall c R, f x = x → x = a) ∧
          ∀ y ∈ Metric.closedBall c R,
            Filter.Tendsto (fun n => f^[n] y) Filter.atTop (nhds a) ∧ ∀ (n : ℕ), dist (f^[n] y) a ≤ ↑q ^ n * dist y a
